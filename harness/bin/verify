#!/bin/sh
# verify  ->  corre todos los checks. Es la unica metrica del proyecto.
# TRES estados, no dos. El tercero existe porque un check que no pudo medir NO es un
# fallo medido: confundirlos es como se actua sin fundamento.
#   salida 0 = VERDE    salida 1 = ROJO (medido)    salida 2 = NOMED (no se pudo medir)
set -u
B=/srv/coinanalyze/harness
rojo=0; verde=0; nomed=0
for c in "$B"/checks/*.sh; do
  [ -x "$c" ] || continue
  id=$(basename "$c" .sh)
  out=$("$c" 2>&1); rc=$?
  case "$rc" in
    0) estado=VERDE; verde=$((verde+1)) ;;
    2) estado=NOMED; nomed=$((nomed+1)) ;;
    *) estado=ROJO;  rojo=$((rojo+1))  ;;
  esac
  printf '%-22s %-5s %s\n' "$id" "$estado" "$(printf '%s' "$out" | head -1 | cut -c1-70)"
done
# K63 · EL VEREDICTO NO ES UNA PROPIEDAD DEL SISTEMA, ES DEL PAR SISTEMA-OBSERVADOR.
# Medido: bajo devops hay 5 ROJO y bajo root 7, o sea que la identidad degradada TAPA
# rojos reales. Copiar un marcador a una libreta sin la identidad al lado produce
# exactamente la cifra falsa y plausible que este arnes existe para evitar.
quien=$(id -un)

# K63 UN EJE MAS ALLA · EL VEREDICTO TAMPOCO ES UNA PROPIEDAD DEL ARBOL SOLO.
# harness/bin y harness/checks son ENLACES a repo/harness/*, asi que los checks que
# corren son los de LA RAMA EN QUE ESTE EL ARBOL. Declarar la identidad y callar la rama
# produce marcadores que parecen el mismo y no lo son.
# MEDIDO EL 2026-08-27, y la evidencia es un dia entero de trabajo: se publicaron TRES
# marcadores como si fueran uno.
#   26 VERDE 7 ROJO 0 NOMED  ·  arbol en claude/k31-cifra-en-pantalla
#   25 VERDE 8 ROJO 0 NOMED  ·  misma rama, antes de restaurar K49
#   24 VERDE 8 ROJO 1 NOMED  ·  arbol en claude/k49-respaldo-no-se-rinde
# Cada uno cierto de SU arbol, NINGUNO de main, y uno acabo en el traspaso del rol como
# "el estado". La prueba de que no es teorico: el mismo K31 daba 27 rutas en una rama y
# 25 en otra, con criterios distintos. No eran cifras en disputa: eran dos arboles.
#
# SE LE PREGUNTA A LA CARPETA DE LOS CHECKS, no al repo por su ruta: es la que de verdad
# acaba de producir el veredicto, y con el enlace de por medio esa es la unica pregunta
# que no se puede contestar de memoria.
#
# "+cambios" cuenta SOLO ficheros VERSIONADOS modificados, que es lo que hace que los
# checks difieran del SHA que se declara.
#
# LO QUE DECIA AQUI Y ERA FALSO: "un fichero sin versionar al lado no cambia lo que el
# check ejecuta". Si lo cambia, y el 2026-09-04 se cobro. verify:9 globea checks/*.sh, o
# sea que UN CHECK SIN VERSIONAR ES UN CHECK QUE CORRE Y CUENTA. Ese dia el marcador
# publico "43 VERDE main 752d435" cuando 752d435 no contenia K88: el +1 VERDE venia de un
# fichero que no estaba en ese commit y el marcador no lo decia. Repetir esa medicion
# desde el SHA declarado da 42, no 43. Es la misma enfermedad que el propio K63 describe
# tres parrafos mas arriba -un marcador que parece el mismo y no lo es- solo que por el
# eje de lo no versionado en vez del de la rama.
#
# Se cuenta SOLO lo no versionado de bin/ y checks/, que es lo que decide lo que verify
# ejecuta. Un .md suelto en la raiz del repo sigue sin contar, asi que la marca no queda
# encendida para siempre -que era la preocupacion legitima del comentario viejo-.
rama=$(git -C "$B/checks" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
[ "$rama" = "HEAD" ] && rama='(detached)'
sha=$(git -C "$B/checks" rev-parse --short HEAD 2>/dev/null || echo '?')
[ -n "$(git -C "$B/checks" status --porcelain --untracked-files=no 2>/dev/null)" ] && sha="$sha+cambios"
sinver=$(( $(git -C "$B/checks" ls-files --others --exclude-standard . 2>/dev/null | wc -l)
         + $(git -C "$B/bin"    ls-files --others --exclude-standard . 2>/dev/null | wc -l) ))
[ "$sinver" -gt 0 ] && sha="$sha+${sinver}sinversionar"
arbol="$rama@$sha"

printf '\n%d VERDE   %d ROJO   %d NOMED   ·  medido como %s en %s\n' "$verde" "$rojo" "$nomed" "$quien" "$arbol"
[ "$sinver" -gt 0 ] && printf '%d fichero(s) de harness/{bin,checks} NO estan en %s. Este marcador NO se\nreproduce desde ese commit: commitealos o el numero es de otro arbol.\n' "$sinver" "$sha"
[ "$nomed" -gt 0 ] && printf 'NOMED no es ROJO. Arregla el canal antes de tocar el codigo.\n'
printf '%s\t%d\t%d\t%d\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$verde" "$rojo" "$nomed" "$quien" "$rama" "$sha" >> "$B/estado/verify.tsv"
[ "$rojo" -eq 0 ] && [ "$nomed" -eq 0 ]
