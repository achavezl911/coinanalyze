#!/bin/sh
# verify  ->  corre todos los checks. Es la unica metrica del proyecto.
# TRES estados, no dos. El tercero existe porque un check que no pudo medir NO es un
# fallo medido: confundirlos es como se actua sin fundamento.
#   salida 0 = VERDE    salida 1 = ROJO (medido)    salida 2 = NOMED (no se pudo medir)
set -u
# B ES SOBREESCRIBIBLE PARA QUE ESTO SE PUEDA CONTROLAR. verify es el instrumento con el que
# se mide todo lo demas y hasta hoy era lo unico del arnes sin control propio, precisamente
# porque su ruta estaba clavada. Su control (checks/verify-control.bash) le monta un arnes de
# mentira y comprueba que un check sin bit APARECE. En uso normal no cambia nada.
B=${VERIFY_HARNESS:-/srv/coinanalyze/harness}
TIMEOUT=${VERIFY_TIMEOUT:-600}
command -v timeout >/dev/null 2>&1 || {
  # Si no hubiera `timeout`, correr SIN tope y callarlo seria volver al hueco de antes.
  echo "verify: no hay 'timeout' en el PATH; sin el, un check colgado se lleva el marcador entero" >&2
  exit 2
}
rojo=0; verde=0; nomed=0; vistos=0
for c in "$B"/checks/*.sh; do
  # GLOB SIN EXPANDIR: si no hay ningun .sh, el bucle recibe el patron literal. Se sale y se
  # dice abajo; callarlo seria "0 VERDE 0 ROJO 0 NOMED" con el arnes entero desaparecido.
  [ -e "$c" ] || break
  vistos=$((vistos+1))
  id=$(basename "$c" .sh)
  # UN CHECK SIN BIT DE EJECUCION ES NOMED, NO UN CHECK QUE NO EXISTE.
  # Hasta el 2026-09-06 esta linea era `[ -x "$c" ] || continue` y el check DESAPARECIA de la
  # salida sin decir una palabra. Lo destapo K93, que entro en el indice como 100644 -el unico
  # 100644 de los 53 .sh- y por eso no corrio ni una vez dentro de verify aunque a mano diera
  # VERDE: el marcador publico 52 lineas y nadie podia saber que faltaba una.
  # Un `chmod -x` neutralizaba CUALQUIER check y la unica cifra del proyecto no se enteraba.
  # Es NOMED y no ROJO porque «no se pudo medir» es literalmente lo que pasa: no hay medida
  # que declarar. Y NOMED ya arrastra la consecuencia correcta -verify sale != 0 y avisa-,
  # mientras que una cuarta categoria no cabria en la unica cifra que resume el sistema.
  if [ ! -x "$c" ]; then
    nomed=$((nomed+1))
    printf '%-22s %-5s %s\n' "$id" NOMED 'sin bit de ejecucion: verify no lo corrio (git update-index --chmod=+x)'
    continue
  fi
  # UN CHECK COLGADO NO CUESTA UNA LINEA: CUELGA verify ENTERO Y NO SE PUBLICA NINGUNA CIFRA.
  # Es el peor de los tres huecos que se midieron el 2026-09-06, y es de otra clase que los
  # otros dos: un nombre que no case *.sh o un check en un subdirectorio pierden UN check y
  # el resto del marcador sale; un check que no termina se lleva la unica metrica del
  # proyecto entera, y el modo de fallo es el silencio -no hay salida que leer-.
  #
  # POR CHECK Y GENEROSO, no global. Un tope global repartiria el presupuesto entre checks
  # que no tienen nada que ver y haria que el ultimo muriera por culpa del primero.
  # EL VALOR SALE DE UNA MEDIDA, NO DEL GUSTO, y la medida se puede repetir: con
  # VERIFY_TIEMPOS=1 esta misma linea escribe a stderr cuanto tarda cada check, en segundos.
  # MEDIDO ASI el 2026-09-06 sobre los 54 checks (claude/instrumentos-ciegos@8bb4063):
  #     mediana 1 s · suma 373 s · los seis mas lentos:
  #     158 K31-eslabon5 · 44 K88 · 42 K20-cincoxx · 22 K60 · 16 K43 · 11 K68
  # El tope de 600 s es 3.8 veces el mas lento medido: holgura para que un dia malo de red no
  # invente un NOMED, y aun asi tres ordenes de magnitud por debajo de "para siempre".
  # Se sube sin tocar el fichero:
  #     VERIFY_TIMEOUT=900 harness/bin/verify
  # Y lo que cuesta, dicho en vez de vendido: con 54 checks, un arnes que se colgara ENTERO
  # tardaria 9 h en terminar. Es infinitamente mejor que no terminar nunca, pero no es gratis.
  #
  # `-k` ADEMAS DE LA SEÑAL NORMAL, y no es adorno: varios checks limpian bases desechables
  # en un `trap`, asi que atrapan TERM. Sin el KILL de refuerzo, un check que ignore la
  # primera señal seguiria colgado y el timeout no serviria de nada.
  #
  # 124 -> NOMED, JAMAS ROJO. No pudo medir; no midio mal. Es la misma regla que sostiene
  # todo este arnes, aplicada al reloj.
  t0=$(date +%s)
  out=$(timeout -k 10 "$TIMEOUT" "$c" 2>&1); rc=$?
  [ "${VERIFY_TIEMPOS:-0}" = "1" ] && printf '%s\t%s\n' "$(( $(date +%s) - t0 ))" "$id" >&2
  case "$rc" in
    0) estado=VERDE; verde=$((verde+1)) ;;
    2) estado=NOMED; nomed=$((nomed+1)) ;;
    124|137)
      estado=NOMED; nomed=$((nomed+1))
      out="agoto el tope de $TIMEOUT s y se le mato: no midio. Sube VERIFY_TIMEOUT si el check es legitimamente mas lento, o arreglalo"
      ;;
    *) estado=ROJO;  rojo=$((rojo+1))  ;;
  esac
  printf '%-22s %-5s %s\n' "$id" "$estado" "$(printf '%s' "$out" | head -1 | cut -c1-70)"
done
# LOS DOS HUECOS QUE QUEDABAN DEL GLOB `checks/*.sh`, cerrados el 2026-09-06.
#
# Son los dos que se midieron y se dejaron escritos cuando se cerro el tercero -el tope por
# check-. Ninguno ha mordido nunca: medido, los 18 ficheros de `checks/` que no casan `*.sh`
# son TODOS deliberados -controles `.bash`, un `.tsv`, un `.py`- y el unico subdirectorio es
# `__pycache__`. Pero los dos fallan EN SILENCIO, que es la parte que importa: un check que no
# corre y del que nadie se entera es peor que uno rojo.
#
# EL CRITERIO NO PUEDE SER «TODO LO QUE NO CASE», y esa era la trampa: quejarse de los 18
# llenaria el marcador de NOMED que no son defectos y enseniaria a ignorarlos. Se avisa solo de
# lo que **parece un check y no lo es**:
#   1. un nombre que LLEVA `.sh` pero no TERMINA en `.sh` -un `.sh.bak`, un `.sh~`, un
#      `.sh.disabled`-: alguien escribio un check y el glob no lo ve;
#   2. un `.sh` dentro de un subdirectorio: `checks/*.sh` no recurre.
# Los `.bash` de control, el `.tsv` y el `.py` NO disparan, y eso es deliberado: no llevan `.sh`
# en el nombre y no estan en un subdirectorio.
#
# NO SE INCREMENTA `vistos`, a proposito: `vistos` cuenta CHECKS, y su cero es lo que detecta
# un arnes desaparecido. Un `.sh.bak` suelto no es un arnes.
huerfano() {  # <ruta> <motivo>
  nomed=$((nomed+1))
  printf '%-22s %-5s %s\n' "$(basename "$1")" NOMED "$2"
}
for c in "$B"/checks/*.sh.* "$B"/checks/*.sh~; do
  [ -e "$c" ] || continue
  huerfano "$c" "lleva .sh pero no termina en .sh: el glob checks/*.sh no lo ve y no se corrio"
done
if command -v find >/dev/null 2>&1; then
  # `-L` porque checks/ es un ENLACE: sin el, find no entra y el brazo no mediria nada.
  find -L "$B/checks" -mindepth 2 -name '*.sh' -print 2>/dev/null | while IFS= read -r c; do
    printf '%-22s %-5s %s\n' "$(basename "$c")" NOMED \
      "esta en un subdirectorio ($(dirname "${c#"$B/checks/"}")): checks/*.sh no recurre y no se corrio"
  done
  n_sub=$(find -L "$B/checks" -mindepth 2 -name '*.sh' 2>/dev/null | grep -c . || true)
  nomed=$((nomed + n_sub))
else
  # Sin `find` este brazo no puede medir, y callarlo seria volver al hueco de antes.
  huerfano "(sin find)" "no hay 'find' en el PATH: no se pudo mirar si hay checks en subdirectorios"
fi

# CERO CHECKS NO ES CERO DEFECTOS. Es la misma regla que cada check aplica a su elegible,
# aplicada al arnes entero: sin sujeto no hay veredicto.
if [ "$vistos" -eq 0 ]; then
  nomed=$((nomed+1))
  printf '%-22s %-5s %s\n' '(ninguno)' NOMED "no hay ningun .sh en $B/checks: verify no tiene que medir"
fi
# K63 · EL VEREDICTO NO ES UNA PROPIEDAD DEL SISTEMA, ES DEL PAR SISTEMA-OBSERVADOR.
# Medido: bajo devops hay 5 ROJO y bajo root 7, o sea que la identidad degradada TAPA
# rojos reales. Copiar un marcador a una libreta sin la identidad al lado produce
# exactamente la cifra falsa y plausible que este arnes existe para evitar.
quien=$(id -un)

# K63 UN EJE MAS ALLA · EL VEREDICTO TAMPOCO ES UNA PROPIEDAD DEL ARBOL SOLO.
# harness/bin y harness/checks son ENLACES a repo/harness/*, asi que los checks que
# corren son los de LA RAMA EN QUE ESTE EL ARBOL. Declarar la identidad y callar la rama
# produce marcadores que parecen el mismo y no lo son.
# MEDIDO EL 2026-08-27, y la evidencia es un dia entero de trabajo: se publicaron TRES
# marcadores como si fueran uno.
#   26 VERDE 7 ROJO 0 NOMED  ·  arbol en claude/k31-cifra-en-pantalla
#   25 VERDE 8 ROJO 0 NOMED  ·  misma rama, antes de restaurar K49
#   24 VERDE 8 ROJO 1 NOMED  ·  arbol en claude/k49-respaldo-no-se-rinde
# Cada uno cierto de SU arbol, NINGUNO de main, y uno acabo en el traspaso del rol como
# "el estado". La prueba de que no es teorico: el mismo K31 daba 27 rutas en una rama y
# 25 en otra, con criterios distintos. No eran cifras en disputa: eran dos arboles.
#
# SE LE PREGUNTA A LA CARPETA DE LOS CHECKS, no al repo por su ruta: es la que de verdad
# acaba de producir el veredicto, y con el enlace de por medio esa es la unica pregunta
# que no se puede contestar de memoria.
#
# "+cambios" cuenta SOLO ficheros VERSIONADOS modificados, que es lo que hace que los
# checks difieran del SHA que se declara.
#
# LO QUE DECIA AQUI Y ERA FALSO: "un fichero sin versionar al lado no cambia lo que el
# check ejecuta". Si lo cambia, y el 2026-09-04 se cobro. verify:9 globea checks/*.sh, o
# sea que UN CHECK SIN VERSIONAR ES UN CHECK QUE CORRE Y CUENTA. Ese dia el marcador
# publico "43 VERDE main 752d435" cuando 752d435 no contenia K88: el +1 VERDE venia de un
# fichero que no estaba en ese commit y el marcador no lo decia. Repetir esa medicion
# desde el SHA declarado da 42, no 43. Es la misma enfermedad que el propio K63 describe
# tres parrafos mas arriba -un marcador que parece el mismo y no lo es- solo que por el
# eje de lo no versionado en vez del de la rama.
#
# Se cuenta SOLO lo no versionado de bin/ y checks/, que es lo que decide lo que verify
# ejecuta. Un .md suelto en la raiz del repo sigue sin contar, asi que la marca no queda
# encendida para siempre -que era la preocupacion legitima del comentario viejo-.
rama=$(git -C "$B/checks" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
[ "$rama" = "HEAD" ] && rama='(detached)'
sha=$(git -C "$B/checks" rev-parse --short HEAD 2>/dev/null || echo '?')
[ -n "$(git -C "$B/checks" status --porcelain --untracked-files=no 2>/dev/null)" ] && sha="$sha+cambios"
sinver=$(( $(git -C "$B/checks" ls-files --others --exclude-standard . 2>/dev/null | wc -l)
         + $(git -C "$B/bin"    ls-files --others --exclude-standard . 2>/dev/null | wc -l) ))
[ "$sinver" -gt 0 ] && sha="$sha+${sinver}sinversionar"
arbol="$rama@$sha"

printf '\n%d VERDE   %d ROJO   %d NOMED   ·  medido como %s en %s\n' "$verde" "$rojo" "$nomed" "$quien" "$arbol"
[ "$sinver" -gt 0 ] && printf '%d fichero(s) de harness/{bin,checks} NO estan en %s. Este marcador NO se\nreproduce desde ese commit: commitealos o el numero es de otro arbol.\n' "$sinver" "$sha"
[ "$nomed" -gt 0 ] && printf 'NOMED no es ROJO. Arregla el canal antes de tocar el codigo.\n'
printf '%s\t%d\t%d\t%d\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$verde" "$rojo" "$nomed" "$quien" "$rama" "$sha" >> "$B/estado/verify.tsv"
[ "$rojo" -eq 0 ] && [ "$nomed" -eq 0 ]
