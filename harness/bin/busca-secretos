#!/bin/bash
# busca-secretos · ¿hay un secreto en este conjunto de ficheros?
#
#     busca-secretos <fichero|directorio> ...
#     rc=0  ninguno          rc=1  al menos uno, y los NOMBRA        rc=2  no se pudo mirar
#
# POR QUE EXISTE. Desde COLA 124 el respaldo de las libretas lleva tambien `entregas/`, o sea
# el METODO: recetas, traspasos, auditorias, encargos y predicciones. Eso va a un repo APARTE,
# y un repo es para siempre: un secreto que entre ahi no se quita borrandolo, hay que rotarlo.
# El respaldo se NIEGA a empujar si esto encuentra algo.
#
# LO QUE BUSCA ES UN VALOR, NO UNA PALABRA. Buscar `password` daria positivo en cada linea de
# prosa que hable de contrasenas -y `entregas/` esta lleno de prosa sobre el canal-, asi que el
# check se volveria ruido y alguien lo apagaria. Se buscan COSAS QUE SON un secreto:
#
#   1 · cabeceras de clave privada PEM/OpenSSH
#   2 · una asignacion a un nombre de credencial CON UN VALOR LITERAL de 12+ caracteres, y no
#       una referencia a variable (`PGPASSWORD="$PG_PASSWORD"` es referencia, no secreto)
#   3 · lineas de netrc con `password <valor>`
#   4 · tokens con prefijo conocido (ghp_, github_pat_, AKIA..., sk-...)
#
# LA REGLA PARA QUIEN ESCRIBE EN `entregas/`: NO SE ESCRIBE UN SECRETO CON SU FORMA, NI DE
# EJEMPLO. Se enmascara -`ghp_<...>`, la cabecera PEM partida, la palabra sin el valor-.
# Esto no distingue un ejemplo de una fuga, y HACE BIEN: quien lo lea desde el repo remoto
# tampoco podria. Medido el 2026-09-17: una entrega con cuatro ejemplos literales paro el
# respaldo de TODOS durante horas, y K49 se puso ROJO. Los ejemplos de esta cabecera y los
# del control van enmascarados o construidos en tiempo de ejecucion, por eso mismo.
#
# NO SE BUSCA «ALTA ENTROPIA» A SECAS: en `entregas/` hay md5, sha256 y payloads con hashes por
# todas partes, y un detector de entropia los marcaria todos. Una huella publicada NO es un
# secreto: es justamente lo contrario, es la prueba.
set -uo pipefail
[ $# -ge 1 ] || { echo "uso: busca-secretos <fichero|directorio> ..."; exit 2; }

RE_PEM='-----BEGIN [A-Z ]*PRIVATE KEY-----'
RE_ASIG='(password|passwd|secret|api[_-]?key|token|credential)[a-z_]*[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9/+_.=-]{12,}'
RE_NETRC='^[[:space:]]*(password|machine .* password)[[:space:]]+[^[:space:]$]{6,}'
RE_PREFIJO='(ghp_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{12,}|sk-[A-Za-z0-9]{20,})'

hallazgos=0
mira() {  # <fichero>  -> imprime las lineas sospechosas, vacio si no hay
  local f="$1"
  # DOS TRAMPAS QUE CAZO LA PRIMERA CORRIDA DE ESTE PROPIO BUSCADOR:
  #
  #  1 · `grep` LEE UN PATRON QUE EMPIEZA POR `-` COMO OPCIONES. El de la clave privada empieza
  #      por `-----BEGIN`, asi que grep contestaba «unrecognized option» y el buscador salia
  #      rc=0: el patron mas importante era el unico que NUNCA se aplicaba. Va con `-e`.
  #
  #  2 · EL FILTRO DE TEXTO SE SALTABA LAS CLAVES. Era `file --mime-type | grep ^text/`, y el
  #      mime de un fichero PEM es `application/x-pem-file`: el filtro descartaba EXACTAMENTE
  #      el tipo de fichero que es una clave privada. Ahora el filtro es `grep -I`, que salta
  #      binarios y no opina sobre el tipo.
  #
  # UNA REFERENCIA NO ES UN SECRETO. `X="$Y"`, `X=${Y}` y `X=$(...)` son como el arnes pasa
  # credenciales sin escribirlas, y marcarlas convertiria esto en ruido.
  grep -nIE -e "$RE_PEM" -e "$RE_ASIG" -e "$RE_NETRC" -e "$RE_PREFIJO" "$f" 2>/dev/null \
    | grep -vE '[=:][[:space:]]*["'"'"']?\$' \
    | grep -vE '\$\{[A-Za-z_]' \
    | sed "s|^|   $f:|"
}

for arg in "$@"; do
  if [ -d "$arg" ]; then
    while IFS= read -r f; do
      salida=$(mira "$f")
      [ -n "$salida" ] && { printf '%s\n' "$salida"; hallazgos=$((hallazgos+1)); }
    done < <(find "$arg" -type f)
  elif [ -f "$arg" ]; then
    salida=$(mira "$arg")
    [ -n "$salida" ] && { printf '%s\n' "$salida"; hallazgos=$((hallazgos+1)); }
  else
    echo "busca-secretos: no existe $arg" >&2; exit 2
  fi
done

if [ "$hallazgos" -gt 0 ]; then
  echo "busca-secretos: $hallazgos fichero(s) con algo que PARECE un secreto (arriba, con su linea)." >&2
  exit 1
fi
exit 0
