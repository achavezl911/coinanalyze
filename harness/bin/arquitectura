#!/usr/bin/env python3
# arquitectura · REGENERA LA CAPA DERIVADA DE ARQUITECTURA/ DESDE EL ARBOL DE TRABAJO.
#
# POR QUE ESTO ES UN GENERADOR Y NO UN DOCUMENTO
# Un documento de arquitectura escrito a mano envejece, y uno que miente es PEOR que
# ninguno, porque la gente se fia. En esta casa el patron se ha repetido nueve veces:
# algo existe, parece completo, y esta muerto o sin conectar. La unica forma de que un
# mapa siga siendo cierto en un mes es que NADIE lo escriba: que salga del codigo, y que
# un check (K88) compare lo commiteado contra una regeneracion fresca. Es el patron de
# respalda-libretas/K49 -copia commiteada contra fichero vivo- aplicado a la arquitectura.
#
# LA REGLA QUE MANDA SOBRE TODAS: NO INVENTAR.
# Lo que no se puede derivar del AST se escribe como PENDIENTE con su motivo, nunca en
# blanco y nunca con lo plausible. Un mapa con 40 rutas descritas y 28 pendientes
# declaradas vale; uno con 68 a medias inventadas es la novena repeticion del patron.
#
# DETERMINISMO, Y NO ES UN DETALLE DE ESTILO
# La salida NO lleva fecha, ni SHA, ni rutas absolutas, ni nada que cambie sin que cambie
# el codigo. Si llevara la fecha de generacion, K88 daria ROJO cada vez que se regenera y
# el check se apagaria por ruido en una semana. Todo orden es alfabetico o por linea.
#
# ALCANCE HONESTO DE LO QUE ESTE PROGRAMA PUEDE SABER
# Es analisis ESTATICO. Ve lo que el AST dice. NO ve: despacho dinamico (getattr, dicts de
# funciones), SQL construido por concatenacion en tiempo de ejecucion, ni middlewares que
# reescriben la respuesta. Cada limite de estos se declara en el fichero de la ruta como
# PENDIENTE con su motivo, para que quien lea sepa que ahi hay que mirar el codigo.
from __future__ import annotations

import argparse
import ast
import json
import os
import re
import sys
from pathlib import Path

# --------------------------------------------------------------------------------------
# 0 · DONDE VIVE TODO
# --------------------------------------------------------------------------------------
AQUI = Path(__file__).resolve()
# harness/bin/arquitectura -> harness/bin -> harness -> repo
REPO_POR_DEFECTO = AQUI.parent.parent.parent

VERSION_FORMATO = 3  # sube cuando cambie el formato de salida; K88 lo compara


# --------------------------------------------------------------------------------------
# 1 · EL CATALOGO DE TABLAS · sql/schema.sql
#     Se lee para NO INVENTAR TABLAS. Un identificador que aparece detras de un FROM y no
#     esta en el catalogo puede ser un CTE, un alias o una subconsulta: se aparta a una
#     lista propia en vez de afirmarlo como tabla. Es la diferencia entre derivar y
#     adivinar, y aqui ya se pago adivinar.
# --------------------------------------------------------------------------------------
RE_CREATE_TABLE = re.compile(
    r"CREATE\s+(?:UNLOGGED\s+)?TABLE\s+(?:IF\s+NOT\s+EXISTS\s+)?"
    r"([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)?)\s*\(",
    re.IGNORECASE,
)
RE_CREATE_VIEW = re.compile(
    r"CREATE\s+(?:OR\s+REPLACE\s+)?(?:MATERIALIZED\s+)?VIEW\s+(?:IF\s+NOT\s+EXISTS\s+)?"
    r"([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)?)",
    re.IGNORECASE,
)


def sin_comentarios_sql(texto: str) -> str:
    """Quita '-- ...' y '/* ... */'. Sin esto, un CREATE TABLE citado dentro de un
    comentario entra al catalogo como si fuera real."""
    texto = re.sub(r"/\*.*?\*/", " ", texto, flags=re.DOTALL)
    texto = re.sub(r"--[^\n]*", " ", texto)
    return texto


def lee_catalogo(repo: Path) -> dict:
    """Devuelve {'tablas': {nombre: {'linea': n, 'columnas': [...]}}, 'vistas': {...}}."""
    f = repo / "sql" / "schema.sql"
    salida = {"tablas": {}, "vistas": {}, "fuente": "sql/schema.sql"}
    if not f.is_file():
        salida["pendiente"] = "no existe sql/schema.sql: no hay catalogo contra el que validar"
        return salida
    crudo = f.read_text(encoding="utf-8", errors="replace")
    limpio = sin_comentarios_sql(crudo)

    # Linea real en el fichero CRUDO: se busca la posicion en el limpio y se cuenta sobre
    # el mismo offset, que se conserva porque sin_comentarios_sql sustituye por espacios
    # de longitud distinta -> se recalcula buscando el nombre en el crudo.
    for m in RE_CREATE_TABLE.finditer(limpio):
        nombre = m.group(1).lower()
        columnas, fin = columnas_de_create(limpio, m.end())
        linea = linea_de(crudo, nombre, "TABLE")
        salida["tablas"][nombre] = {"linea": linea, "columnas": columnas}
    for m in RE_CREATE_VIEW.finditer(limpio):
        nombre = m.group(1).lower()
        salida["vistas"][nombre] = {"linea": linea_de(crudo, nombre, "VIEW")}
    return salida


def linea_de(crudo: str, nombre: str, clase: str) -> int:
    pat = re.compile(
        r"CREATE\s+(?:UNLOGGED\s+|OR\s+REPLACE\s+|MATERIALIZED\s+)*" + clase +
        r"\s+(?:IF\s+NOT\s+EXISTS\s+)?" + re.escape(nombre) + r"\b",
        re.IGNORECASE,
    )
    m = pat.search(crudo)
    return crudo[: m.start()].count("\n") + 1 if m else 0


def columnas_de_create(texto: str, desde: int) -> tuple[list[str], int]:
    """Lee el cuerpo de un CREATE TABLE contando parentesis y saca los nombres de columna
    (el primer identificador de cada elemento de primer nivel que no sea una restriccion)."""
    prof = 1
    i = desde
    n = len(texto)
    elementos: list[str] = []
    actual: list[str] = []
    while i < n and prof > 0:
        c = texto[i]
        if c == "(":
            prof += 1
        elif c == ")":
            prof -= 1
            if prof == 0:
                break
        if prof == 1 and c == ",":
            elementos.append("".join(actual))
            actual = []
        else:
            actual.append(c)
        i += 1
    elementos.append("".join(actual))
    RESTRICCIONES = {
        "primary", "foreign", "unique", "check", "constraint", "exclude", "like", "partition",
    }
    columnas = []
    for e in elementos:
        e = e.strip()
        if not e:
            continue
        m = re.match(r'["]?([A-Za-z_][A-Za-z0-9_]*)["]?', e)
        if not m:
            continue
        nom = m.group(1)
        if nom.lower() in RESTRICCIONES:
            continue
        columnas.append(nom)
    return columnas, i


# --------------------------------------------------------------------------------------
# 2 · EL INDICE DE FUNCIONES DEL ARBOL
#     Sin esto no hay cierre transitivo, y sin cierre transitivo no hay radio de impacto:
#     es exactamente lo que no estaba escrito cuando dos lineas en metrics.py tumbaron el
#     snapshot entero de los tres simbolos durante 24 dias.
# --------------------------------------------------------------------------------------
class Modulo:
    def __init__(self, rel: str, arbol: ast.Module, texto: str):
        self.rel = rel                      # 'app/api.py'
        self.punteado = rel[:-3].replace("/", ".")  # 'app.api'
        self.arbol = arbol
        self.lineas = texto.splitlines()
        self.alias: dict[str, str] = {}     # nombre local -> 'app.metrics.compute_snapshot'
        self.mod_alias: dict[str, str] = {} # 'mt' -> 'app.metrics'
        # CONSTANTES DE MODULO QUE SON CADENAS.  nombre -> (texto, linea de apertura)
        # Existen porque F1 se equivoco aqui: el generador buscaba el literal SQL DENTRO
        # de la funcion, y `await conn.executemany(LIQUIDATION_INSERT_SQL, buffer)` no
        # lleva ningun literal. Resultado: `liquidations_realtime` figuraba leida por 14
        # rutas y sin ningun escritor, cuando su INSERT esta en scalp_collector.py:74 y la
        # tabla tiene 3241 filas vivas en 140. El mapa no mintio -lo declaro PENDIENTE-
        # pero callo algo que si se podia derivar.
        self.constantes: dict[str, tuple[str, int]] = {}


def carga_modulos(repo: Path, paquetes: list[str]) -> dict[str, Modulo]:
    mods: dict[str, Modulo] = {}
    for paq in paquetes:
        base = repo / paq
        if not base.is_dir():
            continue
        for f in sorted(base.rglob("*.py")):
            if "__pycache__" in f.parts:
                continue
            rel = f.relative_to(repo).as_posix()
            texto = f.read_text(encoding="utf-8", errors="replace")
            try:
                arbol = ast.parse(texto, filename=rel)
            except SyntaxError as e:
                sys.stderr.write(f"arquitectura: {rel} no parsea ({e}); se omite\n")
                continue
            mods[rel[:-3].replace("/", ".")] = Modulo(rel, arbol, texto)
    return mods


def indexa_constantes(mods: dict[str, Modulo]) -> None:
    """Constantes de nivel de modulo cuyo valor es una cadena. Tambien las de clase, que
    aparecen en los colectores."""
    for mod in mods.values():
        def recorre(cuerpo, prefijo=""):
            for n in cuerpo:
                if isinstance(n, (ast.Assign, ast.AnnAssign)):
                    destinos = n.targets if isinstance(n, ast.Assign) else [n.target]
                    if (n.value is not None and isinstance(n.value, ast.Constant)
                            and isinstance(n.value.value, str)):
                        for t in destinos:
                            if isinstance(t, ast.Name):
                                mod.constantes[prefijo + t.id] = (n.value.value, n.value.lineno)
                elif isinstance(n, ast.ClassDef):
                    recorre(n.body, f"{prefijo}{n.name}.")
        recorre(mod.arbol.body)


def resuelve_imports(mods: dict[str, Modulo]) -> None:
    """Rellena alias y mod_alias de cada modulo. Solo importa lo del propio arbol; lo de
    fuera (fastapi, asyncpg) se deja sin resolver a proposito: no es nuestro codigo y
    afirmar algo de el seria inventar."""
    for mod in mods.values():
        for n in ast.walk(mod.arbol):
            if isinstance(n, ast.ImportFrom):
                if n.level:  # from . import x  /  from .metrics import y
                    partes = mod.punteado.split(".")
                    raiz = ".".join(partes[: max(1, len(partes) - n.level)])
                    origen = f"{raiz}.{n.module}" if n.module else raiz
                else:
                    origen = n.module or ""
                if not any(origen == m or origen.startswith(m + ".") or m.startswith(origen + ".")
                           for m in mods):
                    continue
                for a in n.names:
                    local = a.asname or a.name
                    if f"{origen}.{a.name}" in mods:      # from app import metrics
                        mod.mod_alias[local] = f"{origen}.{a.name}"
                    else:
                        mod.alias[local] = f"{origen}.{a.name}"
            elif isinstance(n, ast.Import):
                for a in n.names:
                    if a.name in mods:
                        mod.mod_alias[a.asname or a.name.split(".")[0]] = a.name


class Funcion:
    def __init__(self, clave: str, nodo, mod: Modulo):
        self.clave = clave          # 'app.metrics.compute_snapshot'
        self.nodo = nodo
        self.mod = mod
        self.fichero = mod.rel
        self.linea = nodo.lineno
        self.fin = getattr(nodo, "end_lineno", nodo.lineno)
        self.llama: set[str] = set()        # claves del arbol
        self.llama_fuera: set[str] = set()  # nombres no resueltos (libreria o dinamico)
        # cada entrada: {texto, fichero, linea, origen}. La procedencia va DENTRO del dato
        # porque el SQL de una funcion puede vivir en OTRO fichero (constante de modulo).
        self.sql: list[dict] = []
        self.sql_no_resuelto: set[str] = set()
        self.llamada_por: set[str] = set()


def indexa_funciones(mods: dict[str, Modulo]) -> dict[str, Funcion]:
    funcs: dict[str, Funcion] = {}
    for mod in mods.values():
        def recorre(cuerpo, prefijo):
            for n in cuerpo:
                if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    clave = f"{mod.punteado}.{prefijo}{n.name}"
                    funcs[clave] = Funcion(clave, n, mod)
                    # metodos: se indexan como Clase.metodo
                    recorre(n.body, f"{prefijo}{n.name}.")
                elif isinstance(n, ast.ClassDef):
                    recorre(n.body, f"{prefijo}{n.name}.")
        recorre(mod.arbol.body, "")
    return funcs


# --------------------------------------------------------------------------------------
# 3 · QUIEN LLAMA A QUIEN
# --------------------------------------------------------------------------------------
def nombre_de_llamada(nodo: ast.AST) -> str | None:
    """'foo' de foo(), 'mod.foo' de mod.foo(), 'a.b.foo' de a.b.foo()."""
    f = nodo.func if isinstance(nodo, ast.Call) else nodo
    partes = []
    while isinstance(f, ast.Attribute):
        partes.append(f.attr)
        f = f.value
    if isinstance(f, ast.Name):
        partes.append(f.id)
        return ".".join(reversed(partes))
    return None


def resuelve(nombre: str, mod: Modulo, funcs: dict[str, Funcion], mods: dict[str, Modulo]) -> str | None:
    if nombre is None:
        return None
    # 1 · importado explicitamente:  from app.metrics import compute_snapshot
    if nombre in mod.alias and mod.alias[nombre] in funcs:
        return mod.alias[nombre]
    # 2 · definido en el propio modulo
    propio = f"{mod.punteado}.{nombre}"
    if propio in funcs:
        return propio
    # 3 · mod.func con el modulo importado
    if "." in nombre:
        cabeza, resto = nombre.split(".", 1)
        if cabeza in mod.mod_alias:
            cand = f"{mod.mod_alias[cabeza]}.{resto}"
            if cand in funcs:
                return cand
        if cabeza in mod.alias:
            cand = f"{mod.alias[cabeza]}.{resto}"
            if cand in funcs:
                return cand
        # metodo de clase definida en el propio modulo: self.x / Clase.x
        cand = f"{mod.punteado}.{nombre}"
        if cand in funcs:
            return cand
    return None


RE_SQL = re.compile(
    r"\b(SELECT|INSERT\s+INTO|UPDATE|DELETE\s+FROM|WITH|CREATE\s+TABLE|ALTER\s+TABLE|TRUNCATE)\b",
    re.IGNORECASE,
)


def parece_sql(s: str) -> bool:
    return bool(RE_SQL.search(s)) and len(s) > 12


# Metodos de asyncpg cuyo primer argumento ES la consulta. Si ahi va un nombre en vez de
# un literal, hay que ir a buscar la constante: es la unica forma de no perder el escritor.
METODOS_BD = {
    "execute", "executemany", "fetch", "fetchrow", "fetchval", "cursor",
    "prepare", "copy_from_query",
}


def linea_del_verbo(texto: str, linea_apertura: int) -> int:
    """Linea del PRIMER verbo SQL dentro del literal, no la del `\"\"\"` que lo abre.

    Un literal triple de cuatro lineas hacia que el mapa citara la linea de la comilla:
    `ws_collector.py:253` cuando el INSERT esta en la 254, y `scalp_collector.py:73`
    cuando el INSERT esta en la 74 -que es justo la linea con la que el operador cito el
    escritor-. Apuntar a la sentencia y no a la comilla es la diferencia entre una cita
    que se puede seguir y una que hay que corregir a mano cada vez."""
    for i, l in enumerate(texto.splitlines()):
        if RE_SQL.search(l):
            return linea_apertura + i
    return linea_apertura


def resuelve_constante(nodo, mod: Modulo, mods: dict[str, Modulo]):
    """Un ast.Name -> (texto, fichero, linea) si apunta a una constante de cadena del
    arbol. None si no se puede resolver: entonces se declara, no se adivina."""
    if not isinstance(nodo, ast.Name):
        return None
    if nodo.id in mod.constantes:
        texto, linea = mod.constantes[nodo.id]
        return texto, mod.rel, linea
    destino = mod.alias.get(nodo.id)
    if destino:
        modname, _, attr = destino.rpartition(".")
        otro = mods.get(modname)
        if otro and attr in otro.constantes:
            texto, linea = otro.constantes[attr]
            return texto, otro.rel, linea
    return None


def analiza_cuerpos(funcs: dict[str, Funcion], mods: dict[str, Modulo]) -> None:
    """Llena llama / llama_fuera / sql de cada funcion. Las llamadas de funciones ANIDADAS
    se atribuyen tambien a la funcion que las contiene: si un handler define un closure y
    lo usa, ese SQL es suyo a efectos de impacto."""
    for fn in funcs.values():
        # EL DECORADOR NO ES UNA LLAMADA DEL CUERPO. ast.walk sobre el FunctionDef entra
        # tambien en decorator_list, y sin esto toda ruta salia "llamando" a app.get: ruido
        # en las 68 fichas, y peor, un falso positivo en el radio de impacto.
        decoradores = {id(x) for d in getattr(fn.nodo, "decorator_list", []) for x in ast.walk(d)}
        for n in ast.walk(fn.nodo):
            if id(n) in decoradores:
                continue
            if isinstance(n, ast.Call):
                nombre = nombre_de_llamada(n)
                if nombre is None:
                    fn.llama_fuera.add("<llamada dinamica>")
                    continue

                # SQL QUE VIVE EN UNA CONSTANTE DE MODULO. Se mira solo en las llamadas a
                # base de datos: ahi el primer argumento ES la consulta, asi que resolver
                # el nombre no es una suposicion. Fuera de esas llamadas no se resuelve,
                # para no atribuir a una funcion un SQL que solo estaba de paso.
                if nombre.rsplit(".", 1)[-1] in METODOS_BD:
                    for arg in list(n.args) + [k.value for k in n.keywords]:
                        r = resuelve_constante(arg, fn.mod, mods)
                        if r and parece_sql(r[0]):
                            texto, fichero, linea = r
                            fn.sql.append({
                                "texto": texto, "fichero": fichero,
                                "linea": linea_del_verbo(texto, linea),
                                "origen": f"constante {arg.id}",
                            })
                        elif isinstance(arg, ast.Name) and not r and arg is (n.args[0] if n.args else None):
                            # primer argumento de una llamada de BD que no se resuelve:
                            # ahi hay una consulta que este analisis NO ve. Se anota.
                            fn.sql_no_resuelto.add(f"{arg.id} (en {fn.fichero}:{n.lineno})")

                destino = resuelve(nombre, fn.mod, funcs, mods)
                if destino and destino != fn.clave:
                    fn.llama.add(destino)
                elif not destino:
                    fn.llama_fuera.add(nombre)
            elif isinstance(n, ast.Constant) and isinstance(n.value, str):
                if parece_sql(n.value):
                    fn.sql.append({
                        "texto": n.value, "fichero": fn.fichero,
                        "linea": linea_del_verbo(n.value, n.lineno),
                        "origen": "literal",
                    })
            elif isinstance(n, ast.JoinedStr):
                # f-string con SQL dentro: se reconstruye con los huecos marcados. No se
                # afirma el valor de las variables; se marca {?} para que se vea que ahi
                # hay algo que el analisis estatico NO sabe.
                trozos = []
                for v in n.values:
                    if isinstance(v, ast.Constant) and isinstance(v.value, str):
                        trozos.append(v.value)
                    else:
                        trozos.append("{?}")
                s = "".join(trozos)
                if parece_sql(s):
                    fn.sql.append({
                        "texto": s, "fichero": fn.fichero,
                        "linea": linea_del_verbo(s, n.lineno),
                        "origen": "f-string (los huecos van como {?})",
                    })
    for fn in funcs.values():
        for d in fn.llama:
            funcs[d].llamada_por.add(fn.clave)


# --------------------------------------------------------------------------------------
# 4 · DE SQL A TABLAS
# --------------------------------------------------------------------------------------
RE_CTE = re.compile(r"\b([A-Za-z_][A-Za-z0-9_]*)\s+AS\s*(?:MATERIALIZED\s*|NOT\s+MATERIALIZED\s*)?\(", re.IGNORECASE)
RE_LEE = re.compile(r"\b(?:FROM|JOIN)\s+(?:ONLY\s+)?([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)?)", re.IGNORECASE)
RE_ESCRIBE = re.compile(
    r"\b(?:INSERT\s+INTO|UPDATE|DELETE\s+FROM|TRUNCATE(?:\s+TABLE)?|COPY)\s+(?:ONLY\s+)?"
    r"([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)?)",
    re.IGNORECASE,
)
# Palabras que siguen a FROM sin ser tablas.
NO_TABLA = {
    "select", "lateral", "unnest", "generate_series", "values", "jsonb_array_elements",
    "json_array_elements", "regexp_split_to_table", "dual", "only", "extract", "current_date",
}


def tablas_de_sql(sql: str, catalogo: dict) -> dict:
    limpio = sin_comentarios_sql(sql)
    ctes = {m.group(1).lower() for m in RE_CTE.finditer(limpio)}
    lee, escribe, dudosos = set(), set(), set()
    conocidas = set(catalogo["tablas"]) | set(catalogo["vistas"])

    def clasifica(nombre: str, destino: set):
        n = nombre.lower()
        if n in NO_TABLA or n in ctes:
            return
        base = n.split(".")[-1]
        if n in conocidas or base in conocidas:
            destino.add(base if base in conocidas else n)
        else:
            dudosos.add(n)

    for m in RE_LEE.finditer(limpio):
        clasifica(m.group(1), lee)
    for m in RE_ESCRIBE.finditer(limpio):
        clasifica(m.group(1), escribe)
    return {"lee": lee, "escribe": escribe, "dudosos": dudosos}


# --------------------------------------------------------------------------------------
# 5 · QUE CAMPOS PUBLICA UNA RUTA
#     Esta es la parte donde es mas facil mentir, asi que es donde mas se declara lo que
#     no se sabe. Cada campo lleva DE DONDE sale; cada hueco, POR QUE es un hueco.
# --------------------------------------------------------------------------------------
class Campos:
    def __init__(self):
        self.ciertos: dict[str, str] = {}     # campo -> procedencia
        self.pendientes: list[str] = []       # motivos, en lenguaje llano
        self.forma: set[str] = set()          # 'objeto', 'lista de objetos', ...

    def mezcla(self, otro: "Campos"):
        for k, v in otro.ciertos.items():
            self.ciertos.setdefault(k, v)
        for m in otro.pendientes:
            if m not in self.pendientes:
                self.pendientes.append(m)
        self.forma |= otro.forma


def asignaciones(nodo) -> dict[str, ast.AST]:
    """Ultima asignacion simple de cada nombre dentro del cuerpo de una funcion."""
    out: dict[str, ast.AST] = {}
    for n in ast.walk(nodo):
        if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name):
            out[n.targets[0].id] = n.value
        elif isinstance(n, ast.AnnAssign) and isinstance(n.target, ast.Name) and n.value is not None:
            out[n.target.id] = n.value
    return out


def sql_directo_de_tabla(fn: Funcion, catalogo: dict) -> tuple[str, list[str]] | None:
    """Si la funcion hace UN SELECT * (o DISTINCT ON (..) *) sobre UNA sola tabla del
    catalogo, los campos publicados SON las columnas de esa tabla. Es derivacion, no
    suposicion, y se cita el origen. Si hay CTEs o mas de una tabla, se devuelve None:
    ahi ya no se sabe, y decirlo es mejor que acertar por casualidad."""
    for entrada in fn.sql:
        sql = entrada["texto"]
        limpio = sin_comentarios_sql(sql)
        if not re.search(r"SELECT\s+(?:DISTINCT\s+ON\s*\([^)]*\)\s*)?\*", limpio, re.IGNORECASE):
            continue
        if re.search(r"\bWITH\b", limpio, re.IGNORECASE):
            continue
        t = tablas_de_sql(sql, catalogo)
        if len(t["lee"]) == 1 and not t["dudosos"]:
            tabla = next(iter(t["lee"]))
            info = catalogo["tablas"].get(tabla)
            if info and info["columnas"]:
                return tabla, info["columnas"]
    return None


def campos_de_retorno(valor, fn: Funcion, funcs, mods, catalogo, prof=0, vistos=None) -> Campos:
    c = Campos()
    if vistos is None:
        vistos = set()
    if prof > 4:
        c.pendientes.append("la cadena de retornos pasa de 4 saltos: no se sigue mas para no adivinar")
        return c
    if valor is None:
        c.pendientes.append("return sin valor")
        return c

    if isinstance(valor, ast.Await):
        return campos_de_retorno(valor.value, fn, funcs, mods, catalogo, prof, vistos)

    if isinstance(valor, ast.Dict):
        c.forma.add("objeto")
        for k, v in zip(valor.keys, valor.values):
            if k is None:  # **otra
                nombre = nombre_de_llamada(v) if isinstance(v, (ast.Call, ast.Attribute, ast.Name)) else None
                destino = resuelve(nombre, fn.mod, funcs, mods) if nombre else None
                if destino and destino not in vistos:
                    sub = campos_de_funcion(funcs[destino], funcs, mods, catalogo, prof + 1, vistos | {destino})
                    for cam, org in sub.ciertos.items():
                        c.ciertos.setdefault(cam, org)
                    for m in sub.pendientes:
                        if m not in c.pendientes:
                            c.pendientes.append(f"por **{nombre or '?'}: {m}")
                else:
                    c.pendientes.append(
                        f"el objeto se expande con **{nombre or 'expresion'}, que no se resuelve en el arbol: "
                        "sus campos no se pueden derivar")
            elif isinstance(k, ast.Constant) and isinstance(k.value, str):
                c.ciertos[k.value] = f"literal en {fn.fichero}:{getattr(k, 'lineno', fn.linea)}"
            else:
                c.pendientes.append("una clave del objeto es una expresion, no un literal")
        return c

    if isinstance(valor, (ast.List, ast.ListComp)):
        c.forma.add("lista")
        elem = valor.elt if isinstance(valor, ast.ListComp) else (valor.elts[0] if valor.elts else None)
        if elem is not None:
            sub = campos_de_retorno(elem, fn, funcs, mods, catalogo, prof + 1, vistos)
            c.mezcla(sub)
            c.forma.discard("objeto")
            c.forma.add("lista de objetos")
        else:
            c.pendientes.append("lista vacia en el literal: no se puede derivar el elemento")
        return c

    if isinstance(valor, ast.Call):
        nombre = nombre_de_llamada(valor)
        destino = resuelve(nombre, fn.mod, funcs, mods) if nombre else None
        if destino and destino not in vistos:
            return campos_de_funcion(funcs[destino], funcs, mods, catalogo, prof + 1, vistos | {destino})
        # records(rows) / JSONResponse(...) y demas envoltorios que no son del arbol
        if nombre and valor.args:
            sub = campos_de_retorno(valor.args[0], fn, funcs, mods, catalogo, prof + 1, vistos)
            if sub.ciertos or sub.pendientes:
                sub.pendientes.insert(0, f"la respuesta pasa por {nombre}(), que no se puede seguir")
                return sub
        c.pendientes.append(
            f"la respuesta la construye {nombre or 'una llamada'}(), que no se resuelve en el arbol")
        return c

    if isinstance(valor, ast.Name):
        asig = asignaciones(fn.nodo)
        if valor.id in asig and valor.id not in vistos:
            return campos_de_retorno(asig[valor.id], fn, funcs, mods, catalogo, prof + 1, vistos | {valor.id})
        c.pendientes.append(f"devuelve la variable '{valor.id}', cuyo contenido no se resuelve estaticamente")
        return c

    if isinstance(valor, ast.Constant):
        c.forma.add("valor escalar")
        return c

    if isinstance(valor, ast.IfExp):
        c.mezcla(campos_de_retorno(valor.body, fn, funcs, mods, catalogo, prof + 1, vistos))
        c.mezcla(campos_de_retorno(valor.orelse, fn, funcs, mods, catalogo, prof + 1, vistos))
        return c

    c.pendientes.append(f"el valor devuelto es un {type(valor).__name__}, que no se analiza estaticamente")
    return c


def campos_de_funcion(fn: Funcion, funcs, mods, catalogo, prof=0, vistos=None) -> Campos:
    c = Campos()
    if vistos is None:
        vistos = {fn.clave}
    returns = [n for n in ast.walk(fn.nodo) if isinstance(n, ast.Return)]
    # Los return de funciones anidadas no son el return de esta funcion.
    anidadas = [x for x in ast.walk(fn.nodo)
                if isinstance(x, (ast.FunctionDef, ast.AsyncFunctionDef)) and x is not fn.nodo]
    de_anidadas = {id(r) for a in anidadas for r in ast.walk(a) if isinstance(r, ast.Return)}
    returns = [r for r in returns if id(r) not in de_anidadas]

    if not returns:
        directo = sql_directo_de_tabla(fn, catalogo)
        if directo:
            tabla, cols = directo
            for col in cols:
                c.ciertos[col] = f"columna de {tabla} ({catalogo['fuente']})"
            return c
        c.pendientes.append("la funcion no tiene ningun return explicito")
        return c

    for r in returns:
        c.mezcla(campos_de_retorno(r.value, fn, funcs, mods, catalogo, prof, vistos))

    # Rescate honesto: si no salio ningun campo cierto pero la funcion hace un SELECT *
    # sobre UNA tabla del catalogo, los campos son sus columnas. Se cita el origen.
    if not c.ciertos:
        directo = sql_directo_de_tabla(fn, catalogo)
        if directo:
            tabla, cols = directo
            for col in cols:
                c.ciertos[col] = f"columna de {tabla} ({catalogo['fuente']})"
            c.pendientes = [m for m in c.pendientes if "records" not in m and "no se puede seguir" not in m]
            c.pendientes.append(
                f"campos derivados del SELECT * sobre {tabla}: son las columnas declaradas en "
                f"{catalogo['fuente']}, no una lista escrita a mano. Si la consulta filtra "
                "columnas en codigo, esta lista es un techo, no la respuesta exacta")
    return c


# --------------------------------------------------------------------------------------
# 6 · LAS RUTAS
# --------------------------------------------------------------------------------------
METODOS = {"get", "post", "put", "delete", "patch", "head", "options"}


def descubre_rutas(funcs: dict[str, Funcion]) -> list[dict]:
    rutas = []
    for fn in funcs.values():
        for dec in getattr(fn.nodo, "decorator_list", []):
            if not isinstance(dec, ast.Call):
                continue
            nombre = nombre_de_llamada(dec)
            if not nombre or "." not in nombre:
                continue
            objeto, metodo = nombre.rsplit(".", 1)
            if metodo not in METODOS and metodo != "route":
                continue
            if not dec.args or not isinstance(dec.args[0], ast.Constant):
                continue
            camino = dec.args[0].value
            if not isinstance(camino, str):
                continue
            verbos = [metodo.upper()]
            if metodo == "route":
                for kw in dec.keywords:
                    if kw.arg == "methods" and isinstance(kw.value, (ast.List, ast.Tuple)):
                        verbos = [e.value.upper() for e in kw.value.elts
                                  if isinstance(e, ast.Constant) and isinstance(e.value, str)]
            rutas.append({
                "camino": camino,
                "metodos": verbos,
                "objeto": objeto,
                "handler": fn.clave,
                "fichero": fn.fichero,
                "linea": fn.linea,
                "fin": fn.fin,
                "fn": fn,
                "decorador_linea": dec.lineno,
            })
    rutas.sort(key=lambda r: (r["camino"], r["metodos"][0]))
    return rutas


def cierre_de(clave: str, funcs: dict[str, Funcion], tope=4000) -> list[str]:
    """Todas las funciones del arbol alcanzables desde el handler. Es el conjunto cuyo
    cambio puede cambiar esta ruta: la mitad de abajo del radio de impacto."""
    visto = {clave}
    pila = [clave]
    while pila and len(visto) < tope:
        c = pila.pop()
        for d in sorted(funcs[c].llama):
            if d not in visto:
                visto.add(d)
                pila.append(d)
    visto.discard(clave)
    return sorted(visto)


def escritores_y_lectores(funcs: dict[str, Funcion], catalogo: dict) -> dict[str, dict]:
    """Para CADA tabla, quien la escribe y quien la lee en TODO el arbol, no solo desde
    rutas.

    POR QUE ESTO NO ES UN EXTRA. Se midio hoy con el caso que motivo el encargo:
    `compute_snapshot` (app/metrics.py:429) NO aparece en el cierre de llamadas de NINGUNA
    de las 68 rutas -lo llama `compute_and_store_all`, que es el colector-. Y aun asi
    tumbo el snapshot de los tres simbolos 24 dias. El acoplamiento real no viaja por la
    pila de llamadas: viaja por la TABLA.

        compute_snapshot --escribe--> metrics_snapshot --la leen--> N rutas

    Un grafo de llamadas puro (graphify) no ve esa arista, porque no es una llamada. Sin
    unir los dos saltos, la pregunta "si toco esto, que rutas cambian" se contesta con un
    cero tranquilizador y falso, que es el peor resultado posible."""
    RE_VERBO = re.compile(
        r"\b(INSERT\s+INTO|UPDATE|DELETE\s+FROM|TRUNCATE(?:\s+TABLE)?|COPY)\s+(?:ONLY\s+)?"
        r"([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)?)",
        re.IGNORECASE,
    )
    out: dict[str, dict] = {}

    for clave, fn in funcs.items():
        for entrada in fn.sql:
            sql = entrada["texto"]
            t = tablas_de_sql(sql, catalogo)
            # el SITIO sale de la entrada, no de la funcion: cuando el SQL vive en una
            # constante de otro modulo, el sitio correcto es donde esta el SQL.
            sitio = f"{entrada['fichero']}:{entrada['linea']}"
            limpio = sin_comentarios_sql(sql)
            for tabla in t["escribe"]:
                verbo = "?"
                for m in RE_VERBO.finditer(limpio):
                    if m.group(2).lower().split(".")[-1] == tabla:
                        verbo = m.group(1).upper().split()[0]
                        break
                e = out.setdefault(tabla, {"escritores": [], "lectores": []})
                e["escritores"].append({
                    "funcion": clave, "sitio": sitio, "verbo": verbo,
                    "origen": entrada["origen"],
                })
            for tabla in t["lee"]:
                out.setdefault(tabla, {"escritores": [], "lectores": []})["lectores"].append({
                    "funcion": clave, "sitio": sitio, "origen": entrada["origen"],
                })
    for v in out.values():
        v["escritores"] = [
            {"sitio": s, "verbo": vb, "funcion": f, "origen": o}
            for s, vb, f, o in sorted({(e["sitio"], e["verbo"], e["funcion"], e["origen"])
                                       for e in v["escritores"]})]
        v["lectores"] = [
            {"sitio": s, "funcion": f, "origen": o}
            for s, f, o in sorted({(l["sitio"], l["funcion"], l["origen"])
                                   for l in v["lectores"]})]
    return out


# Tipos que FastAPI INYECTA. No son parametros de peticion: quien llame a la ruta no los
# manda ni puede. MEDIDO con harness/bin/capta-foto el 2026-09-04: sin esta distincion,
# `request: Request` salia como obligatorio y el captador omitia 4 rutas de /api/signals/*
# por "parametro obligatorio sin valor" -un hueco en la foto que no existia en la API-.
INYECTADOS = {
    "Request", "Response", "BackgroundTasks", "WebSocket", "HTTPConnection",
    "SecurityScopes", "UploadFile",
}


# =====================================================================================
# F2 · EL RADIO DE IMPACTO
#
# LA PREGUNTA: si toco esta funcion o esta tabla, QUE RUTAS CAMBIAN.
#
# VIAJA POR DOS CAMINOS QUE NO SE PARECEN EN NADA, Y POR ESO SE PUBLICAN SEPARADOS:
#
#   POR LLAMADA   la ruta ejecuta esta funcion. Exacto: o esta en su cierre o no esta.
#   POR TABLA     esta funcion (o quien la llama) escribe una tabla que la ruta LEE.
#                 La ruta no ejecuta nada de esto: se entera por el dato.
#
# Fundir los dos en un solo numero seria volver al cero tranquilizador con otra forma. El
# caso que lo prueba, medido en F1 y confirmado hoy: `compute_snapshot` tiene radio POR
# LLAMADA = 0 rutas y radio POR TABLA = 8. Un unico numero -sea 0, sea 8- oculta la mitad
# de la verdad y la mitad que oculta es la que costo 24 dias de snapshot caido.
#
# EL CAMINO POR TABLA SE PUBLICA CON DOS NUMEROS, NUNCA CON UNO
#
#   k=0    lo que la funcion escribe ELLA MISMA -> rutas que leen esas tablas.
#          EXACTO. Sin ninguna suposicion. Es el dato para toda funcion que escribe.
#   k<=2   sube por los llamadores. COTA SUPERIOR DECLARADA. Hace falta solo para
#          funciones PURAS -como compute_snapshot, que no escribe nada- cuyo valor lo
#          escribe alguien mas arriba: sin la cota, su radio seria cero.
#
# POR QUE DOS Y NO UNO, Y ES UNA CORRECCION DE F2.
# F2 publicaba solo el k<=2 y afirmaba que el corte era "un limite estructural del codigo,
# porque a k=3 aparece el orquestador". ERA FALSO, y estaba ajustado a UN caso. El segundo
# caso lo tira (medido por el operador el 2026-09-05):
#
#   ws_collector._write_minute escribe spot_trades_agg ella misma (INSERT :254 y :275)
#      k=0   -> 10 rutas   <- exacto, y lo confirma un grep de fichas independiente
#      k<=2  -> 17 rutas   <- las 7 de mas entran por ws_collector.run, el bucle del
#                             colector: el MISMO tipo de orquestador que para
#                             compute_snapshot quedaba fuera a k=3, aqui esta DENTRO a
#                             k=2, porque la cadena de llamadas es mas corta.
#
# O sea que el corte no depende de la estructura del sistema sino de la PROFUNDIDAD de
# cada cadena, y eso no es un limite: es un numero que acierta en el caso con el que se
# ajusto. Sobre las 209 funciones con radio por tabla, 196 tienen k<=2 mayor que k=0.
# El 17 no era falso -es una cota verdadera-: lo que faltaba era decir que es una cota.
# =====================================================================================
K_POR_TABLA = 2


def sube_llamadores(clave: str, funcs: dict[str, Funcion], k: int) -> dict[str, int]:
    """Llamadores transitivos hasta distancia k. Devuelve {clave: distancia}."""
    from collections import deque
    dist = {clave: 0}
    q = deque([clave])
    while q:
        c = q.popleft()
        if dist[c] >= k:
            continue
        for p in funcs[c].llamada_por:
            if p not in dist:
                dist[p] = dist[c] + 1
                q.append(p)
    return dist


def calcula_impacto(funcs: dict[str, Funcion], rutas: list[dict], catalogo: dict,
                    tablas: dict, ey: dict) -> dict:
    # quien escribe cada tabla, indexado al reves: funcion -> tablas que escribe
    escribe_directo: dict[str, set] = {}
    for tabla, v in ey.items():
        for e in v["escritores"]:
            escribe_directo.setdefault(e["funcion"], set()).add(tabla)

    # ruta -> cierre, ya calculado. Se invierte una vez en vez de por funcion.
    por_llamada: dict[str, list[str]] = {}
    for r in rutas:
        for clave in [r["handler"]] + r["cierre"]:
            por_llamada.setdefault(clave, []).append(r["camino"])

    lectoras: dict[str, list[str]] = {t: v["leida_por"] for t, v in tablas.items()}

    out: dict[str, dict] = {}
    for clave, fn in funcs.items():
        # --- k=0 · LO QUE ESCRIBE ELLA MISMA. Exacto, sin ninguna suposicion. ----------
        tablas_k0 = sorted(escribe_directo.get(clave, ()))
        rutas_k0 = sorted({r for t in tablas_k0 for r in lectoras.get(t, [])})

        # --- k<=2 · COTA SUPERIOR, porque el valor de una funcion pura lo escribe otro --
        arriba = sube_llamadores(clave, funcs, K_POR_TABLA)
        tablas_escritas: dict[str, list[str]] = {}
        for a in arriba:
            for f2 in [a] + sorted(funcs[a].llama):
                for t in escribe_directo.get(f2, ()):
                    tablas_escritas.setdefault(t, []).append(f2)
        rutas_tabla = sorted({r for t in tablas_escritas for r in lectoras.get(t, [])})
        rutas_llamada = sorted(set(por_llamada.get(clave, [])))
        if not rutas_llamada and not rutas_tabla:
            continue
        out[clave] = {
            "sitio": f"{fn.fichero}:{fn.linea}",
            "por_llamada": rutas_llamada,
            "por_tabla_k0": rutas_k0,
            "tablas_k0": tablas_k0,
            "por_tabla": rutas_tabla,
            "tablas_escritas": {t: sorted(set(v)) for t, v in sorted(tablas_escritas.items())},
            "llamadores_hasta_k": sorted(c for c, d in arriba.items() if d > 0),
            "solo_por_tabla": sorted(set(rutas_tabla) - set(rutas_llamada)),
            "cota_mas_ancha_que_k0": len(rutas_tabla) > len(rutas_k0),
            "total_exacto": len(set(rutas_llamada) | set(rutas_k0)),
            "total": len(set(rutas_llamada) | set(rutas_tabla)),
        }
    return out


# =====================================================================================
# F3 · LA CAPA DECLARADA
#
# EL MECANISMO, Y POR QUE ES UN FICHERO APARTE Y NO UN BLOQUE PRESERVADO
#
# La otra opcion era delimitar un bloque dentro de la ficha y que el generador lo
# conservara al reescribirla. Se descarta por una razon que no es de gusto:
#
#   `--comprueba` regenera a un temporal y compara con lo commiteado. Si el generador
#   PRESERVARA bloques, tendria que LEER esos bloques del destino para escribirlos en el
#   fresco. La comparacion se vuelve circular: el fresco copia del commiteado, y por
#   construccion coinciden SIEMPRE. K88 quedaria ciego exactamente en la capa mas facil de
#   corromper -la unica que se escribe a mano-.
#
# Ademas, regenerar desde cero -borrar ARQUITECTURA/ y correr el generador- perderia toda
# la capa declarada. Un mapa que se destruye al regenerarlo no es regenerable.
#
# Con fichero aparte, `declarada/<ruta>.md` es FUENTE, igual que `app/` o `sql/schema.sql`.
# Se lee, no se reescribe.
#
# QUE ENTRA EN LA FICHA GENERADA: SOLO LA EXISTENCIA Y LA ESTRUCTURA, NO LA PROSA.
# Es deliberado y tiene consecuencias que hay que saber:
#   · editar la PROSA de una declarada -el 99 % de las ediciones- deja el mapa cuadrando:
#     `--comprueba` rc=0, el hook acepta, K88 verde. La capa declarada SOBREVIVE.
#   · romper su ESTRUCTURA -quitar una de las cuatro secciones- si cambia la ficha, y
#     entonces hay que regenerar. Es un guardia parcial, y se declara como parcial:
#     K88 comprueba que la declaracion EXISTE y esta COMPLETA, no que sea CIERTA.
#     Que sea cierta es lo que F5 mide con la bateria.
SECCIONES_DECLARADA = ("PREGUNTA", "VENTANA", "PROMESA", "SUPERFICIE")


def lee_declarada(destino: Path, camino: str) -> dict:
    """Lee ARQUITECTURA/declarada/<slug>.md. Devuelve solo METADATOS -existencia y que
    secciones trae-, nunca la prosa: si la prosa entrara aqui, entraria en la ficha, y
    editar una frase obligaria a regenerar todo el mapa."""
    f = destino / "declarada" / f"{slug(camino)}.md"
    if not f.is_file():
        return {"existe": False, "secciones": [], "faltan": list(SECCIONES_DECLARADA),
                "completa": False, "fichero": f"declarada/{slug(camino)}.md"}
    texto = f.read_text(encoding="utf-8", errors="replace")
    presentes = [s for s in SECCIONES_DECLARADA
                 if re.search(rf"^##\s+{s}\b", texto, re.MULTILINE)]
    faltan = [s for s in SECCIONES_DECLARADA if s not in presentes]
    return {"existe": True, "secciones": presentes, "faltan": faltan,
            "completa": not faltan, "fichero": f"declarada/{slug(camino)}.md"}


# --- lo que en el encargo llamamos "declarado" pero SI se puede medir -------------------
# La superficie de producto no es una opinion: es quien la llama. Se deriva con un grep
# sobre los consumidores reales, y asi no envejece.
CONSUMIDORES = (
    ("panel", "static/app.js"),
    ("panel-html", "static/index.html"),
    ("checks", "harness/checks"),
    ("tests", "tests"),
    ("readme", "README.md"),
    ("herramientas", "tools"),
)

# Nombres de campo que son una marca temporal. Sirven para derivar CON QUE CLAVE declara
# cada ruta su ventana, en vez de suponer que todas usan la misma.
RE_TEMPORAL = re.compile(
    r"(^|_)(ts|at|time|timestamp|as_of|asof|generated|updated|created|cutoff|"
    r"day|date|since|until|from|to|start|end|window|age|edad|lag|stale|fresh)($|_)",
    re.IGNORECASE,
)


# Una linea es COMENTARIO si empieza por # (sh/py) o // (js). Para .py NO basta con esto:
# ver lineas_de_prosa_py().
RE_COMENTARIO = re.compile(r"^\s*(#|//|\*|<!--)")

# LA RUTA ALCANZADA POR UNA VARIABLE DE URL BASE.
#   curl "$API_PROD/api/healthz"     <- el caracter anterior a / es una LETRA
#   curl "${API_PROD}/api/healthz"   <- el anterior es }
# El limite de token de la primera version rechazaba la primera y aceptaba la segunda: el
# mismo codigo con y sin llaves daba dos veredictos. En este repo hay 5 llamadas asi, todas
# curl real con netrc contra produccion, y el detector no acreditaba NINGUNA — acreditaba
# la linea de DEBAJO, que en las cinco es el `echo` del mensaje de error. O sea que el mapa
# decia que el consumidor de la ruta era el aviso de que no habia respondido.
# Se normaliza el prefijo ANTES de casar: $VAR, ${VAR} y esquema://host:puerto se sustituyen
# por un espacio, y despues se aplica el mismo limite de token de siempre.
RE_BASE_URL = re.compile(
    r"\$\{[A-Za-z_][A-Za-z0-9_]*\}"          # ${API_PROD}
    r"|\$[A-Za-z_][A-Za-z0-9_]*"             # $API_PROD
    r"|[a-zA-Z][a-zA-Z0-9+.-]*://[^\s\"'`]*?(?=/api/)"   # https://host:8443
)


def lineas_de_prosa_py(texto: str) -> set:
    """Numeros de linea que son COMENTARIO o CADENA en un .py, segun `tokenize`.

    La heuristica de "la linea empieza por #" funciona en .sh y NO en .py: el caso mas
    comun de todos es el docstring que abre un fichero de test —`tests/test_x.py:1`— y la
    version anterior lo acreditaba como LLAMADA. Eran 15 de las 290 citas .py, y para las
    cinco rutas de /api/signals/* esa era su UNICA cita de tests.
    Un docstring no llama a nada. Aqui se tokeniza en vez de adivinar."""
    import io, tokenize as tk
    fuera = set()
    try:
        for tok in tk.generate_tokens(io.StringIO(texto).readline):
            if tok.type in (tk.COMMENT, tk.STRING):
                for n in range(tok.start[0], tok.end[0] + 1):
                    fuera.add(n)
    except Exception:
        # fichero que no tokeniza (sintaxis rota, encoding raro): no se inventa nada, se
        # cae a la heuristica de linea y ya esta. Declarado, no silencioso.
        return set()
    return fuera


def consumidores_de(repo: Path, camino: str) -> dict:
    """Quien usa esta ruta, fuera del propio api.py. Instrumento externo al AST.

    EL DETECTOR ANTERIOR EXIGIA COMILLAS Y SE DEJABA LA MITAD.
    Buscaba `'/api/x'`, `"/api/x"`, `` `/api/x` ``, `/api/x?`. Los checks K21..K25 escriben
    `RUTA=/api/signals/ledger` SIN comillas y luego llaman por `$RUTA`, asi que las cinco
    fichas de `/api/signals/*` afirmaban "NINGUN consumidor" cuando su consumidor era el
    check que las mide. De 14 rutas "sin consumidor", 8 lo tenian.

    El motivo del diseño viejo era legitimo -que `/api/cvd` no casara con `/api/cvd/spot`-
    y se conserva con un LIMITE DE TOKEN en vez de con comillas: la ruta no puede ir
    seguida de `/`, `-` ni de un caracter de palabra. El caso `/api/cvd` vs `/api/cvd/spot`
    esta puesto como control en K88-control.

    Se separa LLAMADA de MENCION porque no pesan igual: una ruta cuyo unico rastro es un
    comentario NO tiene consumidor, tiene quien habla de ella.
    """
    pat = re.compile(r"(?<![\w/])" + re.escape(camino) + r"(?![\w/-])")
    out: dict[str, dict] = {}
    for etiqueta, rel in CONSUMIDORES:
        base = repo / rel
        ficheros = []
        if base.is_file():
            ficheros = [base]
        elif base.is_dir():
            ficheros = [p for p in sorted(base.rglob("*"))
                        if p.is_file() and p.suffix in (".js", ".html", ".sh", ".bash", ".py", ".md")]
        llamadas, menciones = [], []
        for p in ficheros:
            try:
                texto = p.read_text(encoding="utf-8", errors="replace")
            except Exception:
                continue
            prosa = lineas_de_prosa_py(texto) if p.suffix == ".py" else set()
            for n, linea in enumerate(texto.splitlines(), 1):
                # normalizar la base de URL antes de casar: $VAR, ${VAR}, https://host:8443
                if not pat.search(RE_BASE_URL.sub(" ", linea)):
                    continue
                sitio = f"{p.relative_to(repo).as_posix()}:{n}"
                es_texto = (n in prosa) or bool(RE_COMENTARIO.match(linea)) or p.suffix == ".md"
                (menciones if es_texto else llamadas).append(sitio)
        if llamadas or menciones:
            out[etiqueta] = {"llamadas": llamadas, "menciones": menciones}
    return out


def resume_consumo(cons: dict) -> dict:
    """Aplana el detalle para poder contar sin recorrer la estructura entera."""
    llamadas = [s for v in cons.values() for s in v["llamadas"]]
    menciones = [s for v in cons.values() for s in v["menciones"]]
    en_panel = any(k in cons and cons[k]["llamadas"] for k in ("panel", "panel-html"))
    return {
        "n_llamadas": len(llamadas), "n_menciones": len(menciones),
        "llamada_desde_el_panel": en_panel,
        "solo_mencion": bool(menciones) and not llamadas,
        "sin_ninguno": not llamadas and not menciones,
    }


def claves_temporales_de(campos: dict) -> list[str]:
    return sorted(c for c in campos if RE_TEMPORAL.search(c))


def familia_candidata(parametros: list[dict]) -> dict:
    """Familia de ventana de K43 SUGERIDA por la firma. Es una CANDIDATA, no la
    declaracion: la decide una persona en declarada/<ruta>.md y puede corregirla con cita.
    K43 · (1) ventana de construccion de la foto · (2) coverage de su propia serie ·
    (3) su propio as_of bajo demanda · (4) exenta con cita."""
    nombres = {p["nombre"] for p in parametros if not p.get("lo_inyecta_el_framework")}
    de_serie = nombres & {"limit", "days", "hours", "interval", "lookback", "window", "bars"}
    de_momento = nombres & {"as_of", "asof", "ts", "at", "date", "day", "start", "end", "since"}
    if de_momento:
        return {"candidata": 3, "por": f"pide {sorted(de_momento)}: el operador elige el momento"}
    if de_serie:
        return {"candidata": 2, "por": f"pide {sorted(de_serie)}: coverage de su propia serie"}
    if not nombres or nombres <= {"symbol"}:
        return {"candidata": 1, "por": "solo pide symbol (o nada): estado ambiente"}
    return {"candidata": None, "por": f"parametros {sorted(nombres)}: no encaja en 1/2/3 sin leerla"}


def controles_de_respuesta_conocida(impacto: dict, tablas: dict, ey: dict) -> dict:
    """TRES PREGUNTAS CUYA RESPUESTA YA SE SABE, MEDIDAS POR EL PROPIO GENERADOR.

    Un grafo de impacto es facil de mirar y dificil de creer: sale un numero y no hay con
    que contrastarlo. Estas tres tienen respuesta conocida de antes -dos las midio el
    operador contra el codigo, una contra la base de 140- asi que si el generador se
    tuerce, se ve aqui y no dentro de tres semanas.

    Van DENTRO de derivada.json a proposito: asi K88 las compara en cada corrida por el
    brazo 1, y no dependen de que alguien se acuerde de correr el control."""
    salida = {}

    # 1 · compute_snapshot: 0 rutas por llamada, y por tabla EXACTAMENTE las que leen
    #     metrics_snapshot. Es el caso que motivo todo el encargo.
    i = impacto.get("app.metrics.compute_snapshot", {})
    lectoras = sorted(tablas.get("metrics_snapshot", {}).get("leida_por", []))
    salida["compute_snapshot"] = {
        "pregunta": "si toco compute_snapshot, que rutas cambian",
        "por_llamada": i.get("por_llamada", []),
        "por_tabla": i.get("por_tabla", []),
        "rutas_que_leen_metrics_snapshot": lectoras,
        "esperado": "por_llamada vacio; por_tabla == las lectoras de metrics_snapshot",
        "cuadra": i.get("por_llamada", []) == [] and i.get("por_tabla", []) == lectoras,
    }

    # 2 · spot_trades_agg: dos INSERT de ws_collector y un DELETE de retencion en
    #     daily_agg. El operador lo verifico a mano el 2026-09-04.
    esc = ey.get("spot_trades_agg", {}).get("escritores", [])
    salida["spot_trades_agg"] = {
        "pregunta": "quien escribe spot_trades_agg",
        "escritores": [f"{e['verbo']} {e['sitio']}" for e in esc],
        "esperado": "2 INSERT en app/ws_collector.py y 1 DELETE en app/daily_agg.py",
        "cuadra": (sorted(e["verbo"] for e in esc) == ["DELETE", "INSERT", "INSERT"]
                   and sum(1 for e in esc if e["sitio"].startswith("app/ws_collector.py")
                           and e["verbo"] == "INSERT") == 2
                   and sum(1 for e in esc if e["sitio"].startswith("app/daily_agg.py")
                           and e["verbo"] == "DELETE") == 1),
    }

    # 3 · liquidations_realtime: UN escritor, en app/scalp_collector.py:74, y 14 lectoras.
    #     Es el control que en F1 salio mal -cero escritores- y que hizo falta resolver
    #     constantes de modulo para arreglar. Con la tabla viva en 140 (3241 filas,
    #     ultima 22:00:40Z el 2026-09-04) el cero era imposible.
    esc = ey.get("liquidations_realtime", {}).get("escritores", [])
    lect = sorted(tablas.get("liquidations_realtime", {}).get("leida_por", []))
    salida["liquidations_realtime"] = {
        "pregunta": "quien escribe liquidations_realtime y quien la lee",
        "escritores": [f"{e['verbo']} {e['sitio']} [{e['origen']}]" for e in esc],
        "rutas_lectoras": len(lect),
        "esperado": "1 escritor en app/scalp_collector.py:74 y 14 rutas lectoras",
        "cuadra": (len(esc) == 1
                   and esc[0]["sitio"] == "app/scalp_collector.py:74"
                   and len(lect) == 14),
    }

    # 4 · _write_minute a k=0: las 10 rutas que leen spot_trades_agg, con /api/cvd/spot
    #     dentro. ESTE CONTROL EXISTE PORQUE F2 SE EQUIVOCO. F2 ajusto el k contra un solo
    #     caso (compute_snapshot) y afirmo que el corte era estructural; este segundo caso
    #     lo desmiente -a k<=2 da 17 porque entra ws_collector.run- y obliga a publicar el
    #     k=0 exacto al lado de la cota. Un control con UN caso no es un control: es una
    #     coincidencia con la que se puede vivir mucho tiempo.
    i = impacto.get("app.ws_collector._write_minute", {})
    lect_spot = sorted(tablas.get("spot_trades_agg", {}).get("leida_por", []))
    salida["write_minute_k0"] = {
        "pregunta": "a que rutas llega lo que _write_minute escribe ella misma",
        "por_tabla_k0": i.get("por_tabla_k0", []),
        "por_tabla_k2_cota": len(i.get("por_tabla", [])),
        "rutas_que_leen_spot_trades_agg": lect_spot,
        "esperado": ("por_tabla_k0 == las 10 lectoras de spot_trades_agg, /api/cvd/spot "
                     "dentro; y la cota k<=2 es MAYOR, no igual"),
        "cuadra": (i.get("por_tabla_k0", []) == lect_spot
                   and len(lect_spot) == 10
                   and "/api/cvd/spot" in lect_spot
                   and len(i.get("por_tabla", [])) > len(lect_spot)),
    }

    salida["todos_cuadran"] = all(v["cuadra"] for k, v in salida.items() if isinstance(v, dict))
    return salida


def parametros_de(fn: Funcion) -> list[dict]:
    args = fn.nodo.args
    out = []

    def uno(a, d):
        if a.arg in ("self", "cls"):
            return None
        tipo = ast.unparse(a.annotation) if a.annotation else None
        base = (tipo or "").split("[")[0].split("|")[0].strip().split(".")[-1]
        inyectado = base in INYECTADOS
        return {
            "nombre": a.arg,
            "tipo": tipo,
            "defecto": ast.unparse(d) if d is not None else None,
            # un parametro que pone el framework no es obligatorio PARA QUIEN LLAMA.
            "obligatorio": d is None and not inyectado,
            "lo_inyecta_el_framework": inyectado,
        }

    posicionales = list(args.posonlyargs) + list(args.args)
    defectos = [None] * (len(posicionales) - len(args.defaults)) + list(args.defaults)
    for a, d in zip(posicionales, defectos):
        p = uno(a, d)
        if p:
            out.append(p)
    for a, d in zip(args.kwonlyargs, args.kw_defaults):
        p = uno(a, d)
        if p:
            out.append(p)
    return out


def codigos_de(fn: Funcion, funcs: dict[str, Funcion], cierre: list[str]) -> list[dict]:
    """HTTPException que puede levantar la ruta, ella o cualquiera de su cierre."""
    out = []
    for clave in [fn.clave] + cierre:
        f = funcs[clave]
        for n in ast.walk(f.nodo):
            if isinstance(n, ast.Raise) and isinstance(n.exc, ast.Call):
                if nombre_de_llamada(n.exc) not in ("HTTPException", "fastapi.HTTPException"):
                    continue
                codigo, detalle = None, None
                for kw in n.exc.keywords:
                    if kw.arg == "status_code" and isinstance(kw.value, ast.Constant):
                        codigo = kw.value.value
                    if kw.arg == "detail" and isinstance(kw.value, ast.Constant):
                        detalle = kw.value.value
                if codigo is None and n.exc.args and isinstance(n.exc.args[0], ast.Constant):
                    codigo = n.exc.args[0].value
                out.append({
                    "codigo": codigo, "detalle": detalle,
                    "donde": f"{f.fichero}:{n.lineno}",
                    "propio": clave == fn.clave,
                })
    out.sort(key=lambda x: (str(x["codigo"]), x["donde"]))
    return out


# --------------------------------------------------------------------------------------
# 7 · ESCRITURA
# --------------------------------------------------------------------------------------
def slug(camino: str) -> str:
    s = camino.strip("/").replace("/", "-").replace("{", "").replace("}", "")
    return s or "raiz"


def md_lista(items, vacio="_ninguna_"):
    return "\n".join(f"- {i}" for i in items) if items else vacio


def escribe(repo: Path, destino: Path, datos: dict) -> list[Path]:
    escritos = []
    (destino / "rutas").mkdir(parents=True, exist_ok=True)

    # --- 7a · el JSON, que es la fuente para maquinas y lo que K88 compara -------------
    p = destino / "derivada.json"
    p.write_text(json.dumps(datos, indent=2, ensure_ascii=False, sort_keys=True) + "\n", encoding="utf-8")
    escritos.append(p)

    # --- 7b · un fichero por ruta -----------------------------------------------------
    # POR QUE UN FICHERO POR RUTA: el requisito literal es que una IA que va a tocar
    # /api/setup pueda leer SOLO lo de esa ruta. Con un fichero unico de 68 rutas hay que
    # grepear y adivinar donde acaba una y empieza otra -y el diff no dice cual cambio-.
    # Con un fichero por ruta, "leer lo de /api/setup" es abrir un fichero de 60 lineas.
    for r in datos["rutas"]:
        p = destino / "rutas" / f"{slug(r['camino'])}.md"
        p.write_text(md_ruta(r, datos), encoding="utf-8")
        escritos.append(p)

    # --- 7c · el indice ---------------------------------------------------------------
    p = destino / "INDICE.md"
    p.write_text(md_indice(datos), encoding="utf-8")
    escritos.append(p)

    p = destino / "LEEME.md"
    p.write_text(md_leeme(datos), encoding="utf-8")
    escritos.append(p)

    p = destino / "TABLAS.md"
    p.write_text(md_tablas(datos), encoding="utf-8")
    escritos.append(p)

    # --- 7d · la capa de IMPACTO ------------------------------------------------------
    # Indice general + un fichero POR MODULO FUENTE. El criterio es el mismo que llevo a
    # un fichero por ruta: quien va a tocar `app/metrics.py` abre `impacto/app-metrics.md`
    # y nada mas. Un unico fichero con las 300 funciones seria otra vez algo que hay que
    # leer entero para usar.
    (destino / "impacto").mkdir(parents=True, exist_ok=True)
    p = destino / "IMPACTO.md"
    p.write_text(md_impacto(datos), encoding="utf-8")
    escritos.append(p)
    for modulo, fichero in agrupa_impacto_por_modulo(datos).items():
        p = destino / "impacto" / f"{modulo.replace('/', '-').replace('.py', '')}.md"
        p.write_text(fichero, encoding="utf-8")
        escritos.append(p)
    return escritos


def agrupa_impacto_por_modulo(datos: dict) -> dict[str, str]:
    porm: dict[str, list] = {}
    for clave, i in datos["impacto"]["funciones"].items():
        porm.setdefault(i["sitio"].split(":")[0], []).append((clave, i))
    out = {}
    k = datos["impacto"]["k_por_tabla"]
    for modulo, items in sorted(porm.items()):
        items.sort(key=lambda x: (-x[1]["total"], x[0]))
        L = [f"# Impacto · `{modulo}`", "",
             "> Generado por `harness/bin/arquitectura`. No editar a mano.", "",
             f"{len(items)} funciones de este fichero alcanzan alguna ruta. "
             "**Tocar cualquiera de ellas puede cambiar las rutas que se listan.**", "",
             "El radio POR TABLA va con **dos numeros**: `k=0` es lo que la funcion escribe "
             f"ella misma (**exacto**), y `k<={k}` sube por los llamadores (**cota superior "
             "declarada**). Nunca uno solo.", "",
             "| funcion | linea | por llamada | tabla k=0 | tabla k<=%d (cota) | total exacto |" % k,
             "|---|---|---|---|---|---|"]
        for clave, i in items:
            cota = f"{len(i['por_tabla'])}" + (" ↑" if i["cota_mas_ancha_que_k0"] else "")
            L.append(f"| [`{clave.split('.')[-1]}`](#{clave.split('.')[-1].lower().replace('_', '-')}) "
                     f"| {i['sitio'].split(':')[1]} | {len(i['por_llamada'])} | "
                     f"**{len(i['por_tabla_k0'])}** | {cota} | **{i['total_exacto']}** |")
        L.append("")
        for clave, i in items:
            L.append(f"## {clave.split('.')[-1]}")
            L.append("")
            L.append(f"`{i['sitio']}` · clave completa `{clave}`")
            L.append("")
            # NUNCA UN SOLO NUMERO, tampoco en la cabecera: es donde mas se lee y donde
            # mas facil seria volver a fundir el dato exacto con la cota.
            L.append(f"**Radio exacto: {i['total_exacto']} rutas** de {datos['resumen']['rutas']} "
                     f"· **cota superior: {i['total']}**"
                     + (" (mas ancha)" if i["cota_mas_ancha_que_k0"] else " (igual al exacto)"))
            L.append("")
            L.append(f"### Por llamada — {len(i['por_llamada'])} rutas")
            L.append("")
            L.append("La ruta **ejecuta** esta funcion. Es exacto: o esta en su cierre o no esta.")
            L.append("")
            L.append(md_lista(f"[`{r}`](../rutas/{slug(r)}.md)" for r in i["por_llamada"])
                     if i["por_llamada"] else "_ninguna ruta la ejecuta._")
            L.append("")
            L.append(f"### Por tabla · k=0 — {len(i['por_tabla_k0'])} rutas · **exacto**")
            L.append("")
            if i["tablas_k0"]:
                L.append("Escribe **ella misma**: " + ", ".join(f"`{t}`" for t in i["tablas_k0"]))
                L.append("")
                L.append("Y esas tablas las leen:")
                L.append("")
                L.append(md_lista(f"[`{r}`](../rutas/{slug(r)}.md)" for r in i["por_tabla_k0"]))
            else:
                L.append("_no escribe ninguna tabla ella misma._ Si es una funcion pura, su")
                L.append("impacto por dato viaja por quien la llama: mira la cota de abajo.")
            L.append("")
            L.append(f"### Por tabla · k<={k} — {len(i['por_tabla'])} rutas · **cota superior**")
            L.append("")
            if i["cota_mas_ancha_que_k0"]:
                L.append(f"**Esta cota es MAS ANCHA que el dato exacto** ({len(i['por_tabla'])} contra "
                         f"{len(i['por_tabla_k0'])}). Parte de la diferencia puede entrar por un bucle")
                L.append("de colector que solo comparte llamador, no dato. **Es un techo, no una lista**")
                L.append("**de afectadas.**")
                L.append("")
            if i["tablas_escritas"]:
                L.append("Ella o alguien que la llama hasta k=%d escribe:" % k)
                L.append("")
                for t, quien in i["tablas_escritas"].items():
                    L.append(f"- `{t}` — la escribe {', '.join('`' + q + '`' for q in quien)}")
                L.append("")
                L.append("Y esas tablas las leen:")
                L.append("")
                L.append(md_lista(f"[`{r}`](../rutas/{slug(r)}.md)" for r in i["por_tabla"]))
            else:
                L.append("_ni ella ni sus llamadores hasta k=%d escriben ninguna tabla._" % k)
            L.append("")
            if i["solo_por_tabla"]:
                L.append(f"**{len(i['solo_por_tabla'])} rutas se enteran SOLO por el dato**, sin")
                L.append("ejecutar nada de esta funcion. Son las que un grafo de llamadas no ve:")
                L.append("")
                L.append(md_lista(f"[`{r}`](../rutas/{slug(r)}.md)" for r in i["solo_por_tabla"]))
                L.append("")
            L.append(f"<sub>k=0 es exacto. La cota k<={k} sube por {len(i['llamadores_hasta_k'])} "
                     "llamadores y **no es una lista de afectadas**: es un techo. Lo que este mas "
                     f"arriba de k={k} no se afirma en ninguno de los dos.</sub>")
            L.append("")
        out[modulo] = "\n".join(L) + "\n"
    return out


def md_impacto(datos: dict) -> str:
    k = datos["impacto"]["k_por_tabla"]
    fs = datos["impacto"]["funciones"]
    L = []
    A = L.append
    A("# ARQUITECTURA · IMPACTO · si toco esto, que rutas cambian")
    A("")
    A("> Generado por `harness/bin/arquitectura`. No editar a mano.")
    A("")
    A("## Los dos caminos, y por que van separados")
    A("")
    A("| camino | que significa | exactitud |")
    A("|---|---|---|")
    A("| **por llamada** | la ruta **ejecuta** esta funcion | **exacto**: esta en su cierre o no |")
    A("| **por tabla · k=0** | la funcion **escribe ella misma** una tabla que la ruta **lee** | **exacto** |")
    A(f"| **por tabla · k<={k}** | ella *o quien la llama hasta k={k}* escribe una tabla que la ruta lee | **cota superior** |")
    A("")
    A("La ruta no ejecuta nada del camino por tabla: **se entera por el dato**. Fundir")
    A("cualquiera de estos en un solo numero ocultaria justo la mitad que importa.")
    A("")
    A("```")
    A("compute_snapshot   por llamada:      0 rutas   <- un grafo de llamadas diria 'no afecta a nada'")
    A("                   por tabla k=0:    0 rutas   <- no escribe nada: es una funcion pura")
    A("                   por tabla k<=2:   8 rutas   <- y tumbo el snapshot 24 dias")
    A("```")
    A("")
    A("## Por que DOS numeros, y no uno · una correccion de F2")
    A("")
    A("F2 publicaba solo el `k<=2` y afirmaba que el corte era **un limite estructural del**")
    A("**codigo, porque a k=3 aparece el orquestador**. Era falso, y estaba ajustado a UN")
    A("caso. El segundo caso lo tira:")
    A("")
    A("```")
    A("ws_collector._write_minute escribe spot_trades_agg ELLA MISMA (INSERT :254 y :275)")
    A("   k=0   -> 10 rutas   exacto, y lo confirma un grep de fichas independiente")
    A("   k<=2  -> 17 rutas   las 7 de mas entran por ws_collector.run, el bucle del colector")
    A("```")
    A("")
    A("El **mismo tipo de orquestador** que para `compute_snapshot` quedaba fuera a k=3, aqui")
    A("esta **dentro a k=2**, porque la cadena de llamadas es mas corta. El corte no depende")
    A("de la estructura del sistema sino de **la profundidad de cada cadena**, y eso no es un")
    A("limite: es un numero que acierta en el caso con el que se ajusto.")
    A("")
    A(f"**Sobre las {len(fs)} funciones con radio, {sum(1 for x in fs.values() if x['cota_mas_ancha_que_k0'])} "
      "tienen la cota mas ancha que su k=0.** El 17 no era")
    A("falso -es una cota verdadera-: lo que faltaba era **decir que es una cota**.")
    A("")
    A(f"Solo **{sum(1 for x in fs.values() if x['tablas_k0'])}** de las {len(fs)} escriben alguna tabla")
    A("ellas mismas. Para el resto -las funciones puras- la cota es lo unico que hay, y por")
    A("eso se sigue publicando: sin ella, `compute_snapshot` tendria radio cero.")
    A("")
    A("## A · si toco una TABLA")
    A("")
    A("| tabla | la escriben | rutas que la leen | rutas que la escriben |")
    A("|---|---|---|---|")
    for t in sorted(datos["tablas"]):
        i = datos["tablas"][t]
        A(f"| [`{t}`](TABLAS.md#{t.replace('_', '-')}) | {len(i.get('escritores_del_arbol', []))} | "
          f"**{len(i['leida_por'])}** | {len(i['escrita_por'])} |")
    A("")
    A("## B · si toco una FUNCION")
    A("")
    A(f"{len(fs)} funciones alcanzan alguna ruta. Ordenadas por radio total. **Abre solo el")
    A("fichero de su modulo**: `impacto/<modulo>.md`.")
    A("")
    A("| funcion | sitio | por llamada | tabla k=0 | tabla k<=%d (cota) | total exacto |" % k)
    A("|---|---|---|---|---|---|")
    for clave, i in sorted(fs.items(), key=lambda x: (-x[1]["total_exacto"], -x[1]["total"], x[0])):
        mod = i["sitio"].split(":")[0].replace("/", "-").replace(".py", "")
        cota = f"{len(i['por_tabla'])}" + (" ↑" if i["cota_mas_ancha_que_k0"] else "")
        A(f"| [`{clave}`](impacto/{mod}.md) | `{i['sitio']}` | {len(i['por_llamada'])} | "
          f"**{len(i['por_tabla_k0'])}** | {cota} | **{i['total_exacto']}** |")
    A("")
    A("La flecha ↑ marca las funciones cuya cota es mas ancha que su dato exacto: ahi el")
    A("numero de la cota **es un techo**, no una lista de afectadas.")
    A("")
    A("## C · los tres controles de respuesta conocida")
    A("")
    A("Un grafo de impacto es facil de mirar y dificil de creer: sale un numero y no hay con")
    A("que contrastarlo. Estos tres tienen respuesta conocida de antes, y los mide el propio")
    A("generador en cada corrida, asi que K88 los compara sin que nadie se acuerde de nada.")
    A("")
    # .get y no [] a proposito: un generador al que se le quiten los controles tiene que
    # producir un documento COHERENTE y dejar que sea K88 quien diga NO MEDIDO. Si
    # reventara aqui, el fallo se leeria como "el documento no cuadra", que es otra cosa.
    c = datos.get("controles") or {}
    if not c:
        A("**PENDIENTE · este generador no emite los controles de respuesta conocida.**")
        A("K88 lo marca NO MEDIDO: no es que el impacto este mal, es que no se sabe.")
    else:
        A("| control | esperado | cuadra |")
        A("|---|---|---|")
        for nombre in ("compute_snapshot", "spot_trades_agg", "liquidations_realtime"):
            v = c.get(nombre)
            if v:
                A(f"| `{nombre}` | {v['esperado']} | {'**si**' if v['cuadra'] else '**NO**'} |")
        A("")
        A(f"Los tres cuadran: **{c.get('todos_cuadran')}**.")
    return "\n".join(L) + "\n"


def md_tablas(datos: dict) -> str:
    L = []
    A = L.append
    A("# ARQUITECTURA · las tablas, y por donde viaja el impacto")
    A("")
    A("> Generado por `harness/bin/arquitectura`. No editar a mano.")
    A("")
    A("**El acoplamiento de este sistema NO viaja solo por la pila de llamadas: viaja por la**")
    A("**tabla.** Medido: `compute_snapshot` (`app/metrics.py:429`) no aparece en el cierre de")
    A("llamadas de ninguna de las 68 rutas, y aun asi tumbo el snapshot de los tres simbolos")
    A("durante 24 dias. El camino real es de dos saltos:")
    A("")
    A("```")
    A("compute_snapshot --escribe--> metrics_snapshot --la leen--> N rutas")
    A("```")
    A("")
    A("Un grafo de llamadas no ve esa arista porque no es una llamada. Esta tabla si.")
    A("")
    A("## Tablas que alguna ruta lee o escribe")
    A("")
    A("| tabla | escritores en el arbol | rutas que la leen | rutas que la escriben |")
    A("|---|---|---|---|")
    for t in sorted(datos["tablas"]):
        i = datos["tablas"][t]
        esc = len(i.get("escritores_del_arbol", []))
        A(f"| [`{t}`](#{t.replace('_', '-')}) | {esc if esc else '**0 · PENDIENTE**'} | "
          f"{len(i['leida_por'])} | {len(i['escrita_por'])} |")
    A("")
    A("## Detalle · quien escribe cada una")
    A("")
    for t in sorted(datos["tablas"]):
        i = datos["tablas"][t]
        A(f"### {t}")
        A("")
        A(f"{datos['catalogo_lineas'].get(t, 'sin linea en el catalogo')}.")
        A("")
        esc = i.get("escritores_del_arbol", [])
        if esc:
            A("La escriben:")
            A("")
            for e in esc:
                A(f"- `{e['funcion']}` — **{e['verbo']}** en `{e['sitio']}`")
        else:
            A("**PENDIENTE · ninguna funcion de `app/` la escribe con SQL literal.** O la llena")
            A("algo fuera del paquete analizado, o el SQL se arma en ejecucion.")
        A("")
        if i["leida_por"]:
            A(f"**Si cambia el contenido o el esquema de `{t}`, estas {len(i['leida_por'])} rutas lo notan:**")
            A("")
            for r in i["leida_por"]:
                A(f"- [`{r}`](rutas/{slug(r)}.md)")
            A("")
        if i["escrita_por"]:
            A(f"Rutas que ESCRIBEN en `{t}`: " + ", ".join(f"`{r}`" for r in i["escrita_por"]))
            A("")
    if datos.get("tablas_sin_ruta"):
        A("## Tablas que se escriben pero que ninguna ruta lee")
        A("")
        A("Existen y se llenan, pero **no se publican por ninguna ruta**. No es")
        A("necesariamente un fallo -puede ser estado interno-, pero es exactamente la forma")
        A("del patron que en esta casa se ha repetido nueve veces: algo que existe, parece")
        A("completo, y no esta conectado a nada. Merece una mirada, no una conclusion.")
        A("")
        for t, v in sorted(datos["tablas_sin_ruta"].items()):
            sitios = ", ".join(f"`{e['sitio']}`" for e in v["escritores"][:4])
            A(f"- `{t}` — la escriben {len(v['escritores'])}: {sitios}")
        A("")
    return "\n".join(L) + "\n"


def md_ruta(r: dict, datos: dict) -> str:
    L = []
    A = L.append
    A(f"# `{' '.join(r['metodos'])} {r['camino']}`")
    A("")
    A("> CAPA DERIVADA · **generada** por `harness/bin/arquitectura` desde el AST. No editar a mano:")
    A("> el proximo `arquitectura` lo pisa y K88 se pone ROJO. Lo que falte aqui se arregla")
    A("> en el generador, no en el fichero.")
    A("")
    A(f"Handler `{r['handler'].split('.')[-1]}` · `{r['fichero']}:{r['linea']}`"
      f" (cuerpo hasta la {r['fin']}) · decorador en la linea {r['decorador_linea']}.")
    A("")

    A("## Parametros de entrada")
    A("")
    if r["parametros"]:
        A("| nombre | tipo | por defecto | obligatorio |")
        A("|---|---|---|---|")
        for p in r["parametros"]:
            marca = ("lo pone el framework" if p.get("lo_inyecta_el_framework")
                     else ("si" if p["obligatorio"] else "no"))
            A(f"| `{p['nombre']}` | `{p['tipo'] or '?'}` | "
              f"{'`' + p['defecto'] + '`' if p['defecto'] else '—'} | {marca} |")
    else:
        A("_ninguno_")
    A("")

    A("## Campos que publica")
    A("")
    if r["campos"]:
        A(f"{len(r['campos'])} campos derivados. La procedencia dice de donde sale cada uno.")
        A("")
        A("| campo | de donde sale |")
        A("|---|---|")
        for c in sorted(r["campos"]):
            A(f"| `{c}` | {r['campos'][c]} |")
    else:
        A("**PENDIENTE · no se ha podido derivar ni un campo.**")
    A("")
    if r["campos_pendientes"]:
        A("**Lo que de esta respuesta NO se sabe** (y por eso no se rellena):")
        A("")
        for m in r["campos_pendientes"]:
            A(f"- {m}")
        A("")
    if r["forma"]:
        A(f"Forma de la respuesta segun el AST: {', '.join(sorted(r['forma']))}.")
        A("")
    if r["tipo_retorno"]:
        A(f"Tipo declarado en la firma: `{r['tipo_retorno']}`.")
        A("")

    A("## Tablas que toca")
    A("")
    if r["tablas_lee"] or r["tablas_escribe"]:
        if r["tablas_lee"]:
            A("LEE:")
            A("")
            for t in r["tablas_lee"]:
                A(f"- `{t}` — {datos['catalogo_lineas'].get(t, 'sin linea en el catalogo')}")
                # QUIEN LLENA ESA TABLA. Es el aviso que no existia: si esta ruta se queda
                # muda, la causa suele estar aqui y no en el handler.
                esc = datos["tablas"].get(t, {}).get("escritores_del_arbol", [])
                if esc:
                    for e in esc:
                        A(f"  - la llena `{e['funcion']}` ({e['verbo']}) — `{e['sitio']}`")
                else:
                    A("  - **PENDIENTE · ninguna funcion del arbol la escribe con SQL literal.**")
                    A("    O la llena algo fuera de `app/` (migracion, colector externo, carga manual),")
                    A("    o el SQL se construye en ejecucion y el analisis estatico no lo ve.")
            A("")
        if r["tablas_escribe"]:
            A("**ESCRIBE** (una ruta de lectura que escribe merece mirarse):")
            A("")
            for t in r["tablas_escribe"]:
                A(f"- `{t}` — {datos['catalogo_lineas'].get(t, 'sin linea en el catalogo')}")
            A("")
    else:
        A("_ninguna consulta SQL literal en el cierre de esta ruta._")
        A("")
    if r["tablas_dudosas"]:
        A("Identificadores detras de FROM/JOIN que **no** estan en `sql/schema.sql` y que por")
        A("tanto NO se afirman como tabla (pueden ser CTE, alias, funcion o particion):")
        A("")
        A(md_lista(f"`{t}`" for t in r["tablas_dudosas"]))
        A("")

    A("## Funciones que la componen")
    A("")
    A(f"{len(r['cierre'])} funciones del arbol son alcanzables desde este handler. **Tocar cualquiera")
    A("de ellas puede cambiar esta ruta**; es la mitad de abajo del radio de impacto.")
    A("")
    if r["llama_directo"]:
        A("Llamadas directas del handler:")
        A("")
        for c in r["llama_directo"]:
            A(f"- `{c}` — {datos['funciones'][c]['sitio']}")
        A("")
    if r["cierre_indirecto"]:
        A(f"<details><summary>Alcanzables de forma indirecta ({len(r['cierre_indirecto'])})</summary>")
        A("")
        for c in r["cierre_indirecto"]:
            A(f"- `{c}` — {datos['funciones'][c]['sitio']}")
        A("")
        A("</details>")
        A("")
    if r["llama_fuera"]:
        A(f"<details><summary>Llamadas que salen del arbol o no se resuelven ({len(r['llama_fuera'])})</summary>")
        A("")
        A("Libreria de terceros, builtins o despacho dinamico. El analisis estatico se para aqui.")
        A("")
        A(md_lista(f"`{c}`" for c in r["llama_fuera"]))
        A("")
        A("</details>")
        A("")

    A("## Fallos que puede devolver")
    A("")
    if r["codigos"]:
        A("| codigo | detalle | donde | de quien |")
        A("|---|---|---|---|")
        for c in r["codigos"]:
            A(f"| {c['codigo']} | {c['detalle'] or '—'} | `{c['donde']}` | "
              f"{'el propio handler' if c['propio'] else 'una funcion de su cierre'} |")
    else:
        A("_no levanta HTTPException en su cierre. Un fallo aqui sale como 500 del framework._")
    A("")

    A("## Superficie · quien la consume (medido)")
    A("")
    c = r["consumo"]
    A("**LLAMADA** es una linea de codigo que la usa; **MENCION** es un comentario, un")
    A("docstring o un `.md` que la nombra. No pesan igual: una ruta cuyo unico rastro es un")
    A("comentario no tiene consumidor, tiene quien habla de ella.")
    A("")
    if r["consumidores"]:
        A("| donde | llamadas | menciones |")
        A("|---|---|---|")
        for etiqueta, v in sorted(r["consumidores"].items()):
            def muestra(xs):
                if not xs:
                    return "—"
                s = ", ".join(f"`{g}`" for g in xs[:4])
                return s + (f" _(+{len(xs) - 4})_" if len(xs) > 4 else "")
            A(f"| **{etiqueta}** | {muestra(v['llamadas'])} | {muestra(v['menciones'])} |")
        A("")
        if c["llamada_desde_el_panel"]:
            A("**La llama el panel: es superficie de producto.**")
        elif c["solo_mencion"]:
            A(f"**Nadie la llama.** Sus {c['n_menciones']} rastros son todos MENCION -comentario,")
            A("docstring o documento-. Es la forma del patron que en esta casa se ha repetido")
            A("nueve veces: algo de lo que se habla y nadie ejecuta. **Merece una mirada.**")
        else:
            A(f"**No la llama el panel**, pero si {c['n_llamadas']} linea(s) de codigo fuera de el.")
            A("Es **instrumento interno** — o una ruta que el panel dejo de usar y nadie retiro.")
    else:
        A("**NINGUN rastro**, ni llamada ni mencion, en `static/app.js`, `static/index.html`,")
        A("`harness/checks`, `tests`, `tools` ni `README.md`.")
        A("")
        A("No prueba que este muerta -puede llamarla algo fuera del repo, o una IA por su")
        A("nombre-, pero es la forma exacta del patron que en esta casa se ha repetido nueve")
        A("veces. **Merece una mirada, no una conclusion.**")
    A("")

    A("## Ventana · con que clave la declara (derivado)")
    A("")
    fam = r["familia_ventana"]
    A(f"Familia **candidata** de K43: **{fam['candidata'] or 'sin decidir'}** — {fam['por']}.")
    A("")
    A("K43 · (1) ventana de construccion de la foto · (2) coverage de su propia serie ·")
    A("(3) su propio `as_of` bajo demanda · (4) exenta con cita.")
    A("")
    A("**Es una candidata derivada de la firma, no la declaracion.** La decide una persona")
    A("en el fichero de la capa declarada y puede corregirla con cita.")
    A("")
    if r["claves_temporales"]:
        A("Claves temporales entre los campos que publica:")
        A("")
        A(md_lista(f"`{c}`" for c in r["claves_temporales"]))
    else:
        A("**Ninguna clave temporal entre los campos derivados.** O no publica marca de")
        A("tiempo, o sus campos no se pudieron derivar (mira arriba). Lo segundo NO es lo")
        A("mismo que lo primero: la foto de produccion lo decide, no este documento.")
    A("")

    A("## Capa DECLARADA")
    A("")
    d = r["declarada"]
    if d["completa"]:
        A(f"**Declarada** en [`{d['fichero']}`](../{d['fichero']}) — pregunta del trader,")
        A("familia de ventana decidida, promesa y superficie, cada una con su cita.")
    elif d["existe"]:
        A(f"**INCOMPLETA** en [`{d['fichero']}`](../{d['fichero']}): faltan las secciones")
        A(", ".join(f"`{s}`" for s in d["faltan"]) + ".")
    else:
        A(f"**PENDIENTE de declaracion.** No existe `{d['fichero']}`.")
        A("")
        A("Que pregunta del trader contesta, a que familia de ventana pertenece y que")
        A("promete NO se derivan del codigo: se escriben a mano. Mientras no esten, esta")
        A("ruta esta descrita pero **no declarada**, y K88 la cuenta.")
    A("")
    A("## Radio de impacto")
    A("")
    k = datos["impacto"]["k_por_tabla"]
    fs = datos["impacto"]["funciones"]
    # las funciones del cierre de esta ruta, ordenadas por lo ANCHO que es su radio: las
    # de arriba son las que, si las tocas, se llevan por delante mas cosas ademas de esta.
    suyas = [(c, fs[c]) for c in [r["handler"]] + r["cierre"] if c in fs]
    suyas.sort(key=lambda x: (-x[1]["total"], x[0]))
    A(f"El radio por tabla va con **dos numeros**: `k=0` es lo que la funcion escribe ella")
    A(f"misma (**exacto**) y `k<={k}` sube por los llamadores (**cota superior declarada**;")
    A("lo que este mas arriba no se afirma).")
    A("")
    if suyas:
        A("Las funciones de esta ruta, y a cuantas rutas MAS llega cada una. Un numero alto")
        A("significa que ese arreglo de dos lineas no es de dos lineas:")
        A("")
        A("| funcion | por llamada | tabla k=0 | tabla k<=%d (cota) | total exacto | detalle |" % k)
        A("|---|---|---|---|---|---|")
        for clave, i in suyas[:25]:
            mod = i["sitio"].split(":")[0].replace("/", "-").replace(".py", "")
            cota = f"{len(i['por_tabla'])}" + (" ↑" if i["cota_mas_ancha_que_k0"] else "")
            A(f"| `{clave}` | {len(i['por_llamada'])} | **{len(i['por_tabla_k0'])}** | {cota} | "
              f"**{i['total_exacto']}** | [impacto](../impacto/{mod}.md) |")
        if len(suyas) > 25:
            A(f"| _… y {len(suyas) - 25} mas_ | | | | | [IMPACTO.md](../IMPACTO.md) |")
        A("")
    else:
        A("_ninguna funcion de esta ruta alcanza otra ruta._")
        A("")
    A("**El inverso completo -si toco X, que rutas cambian- esta en**")
    A("[`IMPACTO.md`](../IMPACTO.md), con X funcion o tabla.")
    return "\n".join(L) + "\n"


def md_indice(datos: dict) -> str:
    L = []
    A = L.append
    A("# ARQUITECTURA · indice de rutas")
    A("")
    A("> Generado por `harness/bin/arquitectura`. No editar a mano.")
    A("")
    A(f"{datos['resumen']['rutas']} rutas descubiertas en el arbol. Para trabajar sobre una,")
    A("**abre solo su fichero**: no hace falta leer nada mas.")
    A("")
    A("| ruta | metodo | campos | tablas | funciones | ficha |")
    A("|---|---|---|---|---|---|")
    for r in datos["rutas"]:
        n_campos = len(r["campos"]) if r["campos"] else 0
        marca = f"{n_campos}" if n_campos else "**0 · PENDIENTE**"
        A(f"| `{r['camino']}` | {' '.join(r['metodos'])} | {marca} | "
          f"{len(r['tablas_lee']) + len(r['tablas_escribe'])} | {len(r['cierre'])} | "
          f"[ficha](rutas/{slug(r['camino'])}.md) |")
    A("")
    A("## Rutas cuyos campos NO se han podido derivar")
    A("")
    sin = [r for r in datos["rutas"] if not r["campos"]]
    if sin:
        A(f"{len(sin)} de {datos['resumen']['rutas']}. Cada una con su motivo en la ficha.")
        A("")
        for r in sin:
            motivo = r["campos_pendientes"][0] if r["campos_pendientes"] else "sin motivo registrado"
            A(f"- `{r['camino']}` — {motivo}")
    else:
        A("_ninguna: las rutas descubiertas tienen al menos un campo derivado._")
    A("")
    A("## Tablas, y que rutas las tocan")
    A("")
    A("| tabla | la leen | la escriben |")
    A("|---|---|---|")
    for t in sorted(datos["tablas"]):
        info = datos["tablas"][t]
        A(f"| `{t}` | {len(info['leida_por'])} | {len(info['escrita_por'])} |")
    return "\n".join(L) + "\n"


def md_leeme(datos: dict) -> str:
    r = datos["resumen"]
    return f"""# ARQUITECTURA · la arquitectura funcional viva

> **Este directorio se REGENERA. No se edita a mano.**
> `harness/bin/arquitectura` lo produce entero desde el AST del arbol, y
> `harness/checks/K88-la-arquitectura-que-miente.sh` se pone ROJO si lo commiteado no
> coincide con una regeneracion fresca, o si hay una ruta en el codigo que aqui no esta.

## Por que existe

Un documento de arquitectura escrito a mano envejece, y **uno que miente es peor que
ninguno, porque la gente se fia**. El caso que lo pago: `compute_snapshot` alimenta
`publish_snapshot`, que alimenta `metrics_snapshot`, que alimenta N rutas. Eso no estaba
escrito en ningun sitio, y un arreglo de dos lineas en `metrics.py` tumbo el snapshot
entero de los tres simbolos durante 24 dias sin que nadie supiera el alcance.

## Las tres capas

| capa | quien la escribe | estado |
|---|---|---|
| **DERIVADA** | el generador, desde el codigo | **viva** — es esto |
| **DECLARADA** | a mano, una vez (pregunta del trader, familia de ventana K43, promesa) | PENDIENTE · F3 |
| **IMPACTO** | el generador, invirtiendo el grafo (`funcion/tabla -> rutas`) | PENDIENTE · F2 |

## Como se lee sin leerlo entero

1. `INDICE.md` — las {r['rutas']} rutas en una tabla.
2. `rutas/<ruta>.md` — **una ficha por ruta.** Si vas a tocar `/api/setup`, abre
   `rutas/api-setup.md` y nada mas.
3. `derivada.json` — lo mismo para maquinas, y es lo que K88 compara.

## Que sabe y que no sabe

Es analisis **estatico**: ve lo que el AST dice. **No ve** despacho dinamico, SQL
concatenado en tiempo de ejecucion, ni middlewares que reescriban la respuesta. Cada
limite de esos aparece como PENDIENTE **con su motivo** en la ficha de la ruta. Un hueco
declarado es informacion; un hueco rellenado con lo plausible es la averia que este
directorio existe para no repetir.

## Cifras de esta regeneracion

- rutas descubiertas: **{r['rutas']}**
- rutas con al menos un campo derivado: **{r['rutas_con_campos']}**
- rutas sin ningun campo derivado (PENDIENTE, con motivo en su ficha): **{r['rutas_sin_campos']}**
- funciones alcanzables desde alguna ruta: **{r['funciones_alcanzables']}**
- tablas del catalogo `sql/schema.sql`: **{r['tablas_catalogo']}**
- tablas alcanzadas desde alguna ruta: **{r['tablas_alcanzadas']}**

## Regenerar

```sh
harness/bin/arquitectura            # reescribe ARQUITECTURA/
harness/bin/arquitectura --comprueba  # no escribe; rc=1 si lo commiteado no cuadra
harness/checks/K88-la-arquitectura-que-miente.sh
```

## LOS INSUMOS · que lee el generador, y que pasa si falta

**Regenerar en otra maquina con media copia produce un mapa distinto y K88 lo llama ROJO.**
Medido regenerando desde copias parciales: **sin `static/`, `tests/`, `tools/` y
`README.md` difieren 56 ficheros; sin `harness/checks`, 15.** No es un fallo del check: es
que el mapa describe menos cosas porque ha visto menos.

| insumo | para que | si falta |
|---|---|---|
| `app/**.py` | AST: rutas, campos, llamadas, SQL, constantes | no hay mapa |
| `sql/schema.sql` | catalogo de tablas y columnas; valida que una tabla existe | ninguna tabla se afirma |
| `static/app.js`, `static/index.html` | consumidores: **llamada** desde el panel | toda ruta parece instrumento interno |
| `harness/checks/**` | consumidores: checks que la miden | 5 rutas de `/api/signals/*` salen huerfanas |
| `tests/**`, `tools/**`, `README.md` | consumidores: llamadas y menciones | menos rastro del que hay |
| `ARQUITECTURA/declarada/*.md` | **FUENTE de la capa declarada**; se lee, no se escribe | todas las rutas salen PENDIENTE de declaracion |

Lo que el generador **NO** lee, y es deliberado: la foto de produccion
(`entregas/*-foto-prod-*.json`). No esta versionada, asi que si entrara aqui, regenerar sin
ella daria ROJO por no tener una medicion en vez de por estar mal. Lo observado en
produccion vive en la capa **declarada**, con su fecha y su cita.
"""


# --------------------------------------------------------------------------------------
# 8 · MAIN
# --------------------------------------------------------------------------------------
def construye(repo: Path, paquetes: list[str], destino: Path | None = None) -> dict:
    catalogo = lee_catalogo(repo)
    mods = carga_modulos(repo, paquetes)
    resuelve_imports(mods)
    indexa_constantes(mods)
    funcs = indexa_funciones(mods)
    analiza_cuerpos(funcs, mods)
    rutas_crudas = descubre_rutas(funcs)

    tablas: dict[str, dict] = {}
    rutas = []
    funciones_usadas: dict[str, dict] = {}

    for r in rutas_crudas:
        fn: Funcion = r["fn"]
        cierre = cierre_de(fn.clave, funcs)
        lee, escribe, dudosos = set(), set(), set()
        for clave in [fn.clave] + cierre:
            for entrada in funcs[clave].sql:
                t = tablas_de_sql(entrada["texto"], catalogo)
                lee |= t["lee"]; escribe |= t["escribe"]; dudosos |= t["dudosos"]

        campos = campos_de_funcion(fn, funcs, mods, catalogo)
        directo = sorted(fn.llama)
        fuera = sorted(x for x in fn.llama_fuera if x)
        tipo_ret = ast.unparse(fn.nodo.returns) if fn.nodo.returns else None

        for clave in [fn.clave] + cierre:
            f = funcs[clave]
            funciones_usadas.setdefault(clave, {
                "sitio": f"`{f.fichero}:{f.linea}`",
                "fichero": f.fichero, "linea": f.linea,
            })

        for t in lee:
            tablas.setdefault(t, {"leida_por": [], "escrita_por": []})["leida_por"].append(r["camino"])
        for t in escribe:
            tablas.setdefault(t, {"leida_por": [], "escrita_por": []})["escrita_por"].append(r["camino"])

        rutas.append({
            "camino": r["camino"],
            "metodos": r["metodos"],
            "handler": r["handler"],
            "fichero": r["fichero"],
            "linea": r["linea"],
            "fin": r["fin"],
            "decorador_linea": r["decorador_linea"],
            "parametros": parametros_de(fn),
            "tipo_retorno": tipo_ret,
            "campos": dict(sorted(campos.ciertos.items())),
            "campos_pendientes": campos.pendientes,
            "forma": sorted(campos.forma),
            "tablas_lee": sorted(lee),
            "tablas_escribe": sorted(escribe),
            "tablas_dudosas": sorted(dudosos),
            "llama_directo": directo,
            "cierre": cierre,
            "cierre_indirecto": [c for c in cierre if c not in set(directo)],
            "llama_fuera": fuera,
            "codigos": codigos_de(fn, funcs, cierre),
            # --- F3 · lo medible de la capa declarada ---------------------------------
            "consumidores": (cons := consumidores_de(repo, r["camino"])),
            "consumo": resume_consumo(cons),
            "claves_temporales": claves_temporales_de(dict(sorted(campos.ciertos.items()))),
            "familia_ventana": familia_candidata(parametros_de(fn)),
            "declarada": lee_declarada(destino, r["camino"]) if destino else
                         {"existe": False, "secciones": [], "faltan": list(SECCIONES_DECLARADA),
                          "completa": False, "fichero": f"declarada/{slug(r['camino'])}.md"},
        })

    for t in tablas.values():
        t["leida_por"] = sorted(set(t["leida_por"]))
        t["escrita_por"] = sorted(set(t["escrita_por"]))

    # El segundo salto del acoplamiento: quien alimenta cada tabla desde FUERA de las
    # rutas (los colectores). Sin esto, compute_snapshot sale con impacto cero.
    ey = escritores_y_lectores(funcs, catalogo)
    for t, info in tablas.items():
        info["escritores_del_arbol"] = ey.get(t, {}).get("escritores", [])
        info["lectores_del_arbol"] = ey.get(t, {}).get("lectores", [])
    # tablas que nadie lee desde una ruta pero que alguien escribe: existen y no se
    # publican. Se listan aparte en vez de desaparecer del mapa.
    solo_escritura = {
        t: v for t, v in sorted(ey.items())
        if t not in tablas and v["escritores"]
    }

    impacto = calcula_impacto(funcs, rutas, catalogo, tablas, ey)
    # cada ficha de ruta lleva el radio de SU handler al alcance de la mano
    for r in rutas:
        r["impacto_del_handler"] = impacto.get(r["handler"], {}).get("total", 0)
    # LA VENTANA OBSERVADA EN LA FOTO NO ENTRA AQUI, y es deliberado. Las claves con que
    # cada ruta declara su instante EN EL CUERPO solo se ven midiendo produccion
    # (entregas/20260904-foto-prod-1.json), y ese fichero no esta versionado: si el
    # generador lo leyera, regenerar en otra maquina daria un mapa distinto y K88 seria
    # ROJO por no tener una medicion, no por estar mal. Lo observado va a la capa
    # DECLARADA -que es donde vive lo medido, con su fecha y su cita-; lo derivable del
    # AST se queda aqui.

    con = sum(1 for r in rutas if r["campos"])
    return {
        "version_formato": VERSION_FORMATO,
        "impacto": {
            "k_por_tabla": K_POR_TABLA,
            "nota": ("radio por tabla calculado subiendo llamadores hasta k=%d; "
                     "lo que este mas arriba NO se afirma" % K_POR_TABLA),
            "funciones": impacto,
        },
        "controles": controles_de_respuesta_conocida(impacto, tablas, ey),
        "paquetes_analizados": paquetes,
        "rutas": rutas,
        "tablas": dict(sorted(tablas.items())),
        "tablas_sin_ruta": solo_escritura,
        "catalogo_lineas": {
            t: f"`{catalogo['fuente']}:{i['linea']}`, {len(i['columnas'])} columnas"
            for t, i in sorted(catalogo["tablas"].items())
        },
        "funciones": dict(sorted(funciones_usadas.items())),
        "resumen": {
            "rutas": len(rutas),
            "rutas_con_campos": con,
            "rutas_sin_campos": len(rutas) - con,
            # FUNCIONES ALCANZABLES DESDE ALGUNA RUTA, no el censo del arbol.
            # MEDIDO con el control N3 de K88: publicar len(funcs) -las 731 del arbol-
            # hacia que anadir un modulo huerfano que ninguna ruta alcanza pusiera K88 en
            # ROJO. El mapa de rutas no habia cambiado en nada. Un check que enrojece por
            # algo que no describe se apaga por ruido en una semana, y entonces deja de
            # cazar tambien lo que si importa. Esta cifra solo se mueve si cambia el grafo
            # que el documento de verdad describe.
            "funciones_alcanzables": len(funciones_usadas),
            "tablas_catalogo": len(catalogo["tablas"]),
            "tablas_alcanzadas": len(tablas),
            "declaradas_completas": sum(1 for r in rutas if r["declarada"]["completa"]),
            "declaradas_incompletas": sum(
                1 for r in rutas if r["declarada"]["existe"] and not r["declarada"]["completa"]),
            "sin_declarar": sum(1 for r in rutas if not r["declarada"]["existe"]),
            # sin NINGUN rastro, y aparte las que solo tienen menciones: son cosas
            # distintas y fundirlas fue el defecto del detector anterior.
            "sin_consumidor": sum(1 for r in rutas if r["consumo"]["sin_ninguno"]),
            "solo_mencion": sum(1 for r in rutas if r["consumo"]["solo_mencion"]),
            "sin_llamada": sum(1 for r in rutas if r["consumo"]["n_llamadas"] == 0),
            "sin_clave_temporal": sum(1 for r in rutas if not r["claves_temporales"]),
        },
    }


def main() -> int:
    ap = argparse.ArgumentParser(description="Regenera la capa DERIVADA de ARQUITECTURA/.")
    ap.add_argument("--repo", default=str(REPO_POR_DEFECTO))
    ap.add_argument("--salida", default=None, help="por defecto <repo>/ARQUITECTURA")
    ap.add_argument("--paquetes", default="app", help="separados por coma")
    ap.add_argument("--comprueba", action="store_true",
                    help="no escribe: rc=1 si lo que hay en disco no coincide con la regeneracion")
    ap.add_argument("--json", action="store_true", help="vuelca el JSON por stdout y no escribe nada")
    a = ap.parse_args()

    repo = Path(a.repo).resolve()
    destino = Path(a.salida).resolve() if a.salida else repo / "ARQUITECTURA"
    paquetes = [p.strip() for p in a.paquetes.split(",") if p.strip()]

    # La capa declarada se lee del DESTINO: es fuente, no salida. Con --salida a un
    # temporal (que es lo que hace --comprueba) se sigue leyendo la del arbol, o si no la
    # comparacion diria que sobra la declaracion entera.
    datos = construye(repo, paquetes, destino=(repo / "ARQUITECTURA"))

    if a.json:
        json.dump(datos, sys.stdout, indent=2, ensure_ascii=False, sort_keys=True)
        print()
        return 0

    if a.comprueba:
        import tempfile, filecmp
        with tempfile.TemporaryDirectory() as tmp:
            fresco = Path(tmp)
            escribe(repo, fresco, datos)
            # LA CAPA DECLARADA NO ENTRA EN LA COMPARACION, Y ES EL CORAZON DEL MECANISMO.
            # `declarada/` es FUENTE -se escribe a mano-, no salida: el generador la lee
            # igual que lee `app/` o `sql/schema.sql`. Compararla contra una regeneracion
            # diria que "sobra" el dia que se escribe la primera, y entonces la unica capa
            # que necesita a una persona seria la unica que el mapa no admite.
            # Lo que SI esta guardado de ella es su huella en la ficha derivada: si existe,
            # si esta completa y su recuento en el resumen. O sea: la PROSA es libre, la
            # ESTRUCTURA no. K88 comprueba que la declaracion existe y esta completa, NO
            # que sea cierta -eso lo mide F5 contra la bateria-.
            def salida_real(base: Path) -> set:
                return {p.relative_to(base).as_posix() for p in base.rglob("*")
                        if p.is_file() and not p.relative_to(base).as_posix().startswith("declarada/")}
            difs = []
            en_disco = salida_real(destino) if destino.is_dir() else set()
            en_fresco = salida_real(fresco)
            for rel in sorted(en_fresco - en_disco):
                difs.append(f"FALTA en lo commiteado: {rel}")
            for rel in sorted(en_disco - en_fresco):
                difs.append(f"SOBRA en lo commiteado (el codigo ya no lo produce): {rel}")
            for rel in sorted(en_fresco & en_disco):
                if not filecmp.cmp(fresco / rel, destino / rel, shallow=False):
                    difs.append(f"DIFIERE de la regeneracion: {rel}")
            for d in difs:
                print(d)
            if difs:
                print(f"\n{len(difs)} discrepancias entre ARQUITECTURA/ y el codigo.")
                return 1
            print(f"ARQUITECTURA/ coincide con la regeneracion fresca ({len(en_fresco)} ficheros).")
            return 0

    escritos = escribe(repo, destino, datos)
    r = datos["resumen"]
    print(f"{len(escritos)} ficheros en {destino.relative_to(repo) if destino.is_relative_to(repo) else destino}")
    print(f"{r['rutas']} rutas · {r['rutas_con_campos']} con campos derivados · "
          f"{r['rutas_sin_campos']} PENDIENTE · {r['funciones_alcanzables']} funciones alcanzables · "
          f"{r['tablas_alcanzadas']} de {r['tablas_catalogo']} tablas alcanzadas")
    return 0


if __name__ == "__main__":
    sys.exit(main())
