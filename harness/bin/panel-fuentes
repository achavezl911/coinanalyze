#!/usr/bin/env python3
"""panel-fuentes · DE QUE FICHEROS ESTA HECHO EL PANEL, descubierto del HTML.

POR QUE EXISTE. La FASE 2 parte `static/app.js` en N modulos. Hoy hay VEINTIOCHO sitios que
derivan algo de la forma del panel dando por hecho que es UN fichero: checks, tests, la sonda
de jsdom y el generador de la capa declarada. Si cada uno lleva su ruta escrita, el dia del
corte unos se callan, otros condenan en falso y el mapa MIENTE -y esa es la cara: un check
mudo se declara, un rojo se investiga, un mapa que miente SE CREE-.

EL CONTRATO QUE ESTE FICHERO IMPLEMENTA, y que la FASE 2 tiene que cumplir:

  1 · `static/index.html` declara el panel con UN UNICO punto de entrada:
          <script type="module" src="/static/app.js"></script>
  2 · los modulos se resuelven entre si con `import`/`export ... from` RELATIVO
      (`./x.js`, `../y/z.js`), todos bajo `static/`.
  3 · `vendor/` NO es el panel: es tercero y va como <script> clasico aparte. Se excluye
      POR SU PREFIJO, que es una regla y no una lista de nombres.
  4 · nadie lleva la lista de modulos escrita a mano. SE DESCUBRE: se lee el <script> del
      HTML y se sigue el grafo de imports. Llevar la lista a mano seria cambiar una forma
      rigida por otra.

VIABILIDAD EN PRODUCCION, MEDIDA EL 2026-09-13 Y NO SUPUESTA:
  · `app/api.py:3786` monta `StaticFiles` en /static -nginx NO sirve los ficheros: su
    `location /` (sites-available/coinalyze:57) hace proxy_pass a :8000-.
  · la respuesta trae `content-type: text/javascript; charset=utf-8`, que es lo que
    `x-content-type-options: nosniff` (nginx:35) exige para que un modulo cargue.
  · la CSP (nginx:34) es `default-src 'self'; script-src 'self'; ...`: los modulos y sus
    imports son del mismo origen, asi que **N modulos no necesitan tocar la CSP**. No hay
    `nonce` ni `hash` por script que haya que multiplicar.

ORDEN DE SALIDA: dependencias ANTES que quien las importa, y el punto de entrada el ultimo.
Asi `--cat` produce una concatenacion que se puede ejecutar, que es lo que necesitan la sonda
de jsdom y los tests de node.

SIN SUJETO NO HAY MEDIDA: si el HTML no declara ningun script de panel, o si un modulo
declarado no existe, esto sale por rc=2 con el motivo. Quien lo llame tiene que propagar ese
NO MEDIDO en vez de seguir con una lista vacia.
"""
import argparse
import pathlib
import re
import sys

RE_SCRIPT = re.compile(r"<script\b[^>]*>", re.I)
RE_SRC = re.compile(r"""\bsrc\s*=\s*["']([^"']+)["']""", re.I)
RE_TYPE = re.compile(r"""\btype\s*=\s*["']([^"']+)["']""", re.I)
# `import x from './y.js'` · `import './y.js'` · `export {x} from './y.js'`
RE_IMPORT = re.compile(
    r"""(?:^|[\s;}])(?:import|export)\b[^;'"]*?["'](\.{1,2}/[^"']+)["']""", re.M)
# `import './x.js';` a secas: ordena, no ata nombres. Es lo unico que `--cat` puede borrar.
RE_IMPORT_DE_EFECTO = re.compile(r"""^[ \t]*import\s+["']\.{1,2}/[^"']+["']\s*;?[ \t]*\r?\n""", re.M)
# `import {a} from './x'` · `import a from './x'` · `export {a} from './x'`: SI atan.
RE_IMPORT_CON_NOMBRES = re.compile(
    r"""^[ \t]*(?:import|export)\s+(?!["'])[^;\n]*?\bfrom\s+["']\.{1,2}/[^"']+["']""", re.M)


def entradas_del_html(repo: pathlib.Path):
    """Los <script src="/static/..."> del panel, en el orden en que el HTML los declara."""
    html = repo / "static" / "index.html"
    if not html.is_file():
        raise SystemExit2(f"no se puede leer {html}")
    texto = html.read_text(encoding="utf-8", errors="replace")
    fuera = []
    for etiqueta in RE_SCRIPT.findall(texto):
        m = RE_SRC.search(etiqueta)
        if not m:
            continue                      # <script> en linea: no es un fichero del panel
        src = m.group(1)
        if not src.startswith("/static/"):
            continue                      # externo: no es el panel
        rel = src[len("/static/"):].split("?")[0]
        if rel.startswith("vendor/"):
            continue                      # regla 3 del contrato: vendor es tercero
        tipo = (RE_TYPE.search(etiqueta) or [None, ""])[1] if RE_TYPE.search(etiqueta) else ""
        fuera.append((rel, tipo.lower()))
    return fuera


class SystemExit2(SystemExit):
    def __init__(self, motivo):
        super().__init__(2)
        self.motivo = motivo


def grafo(repo: pathlib.Path, entrada: str):
    """Sigue los imports relativos desde una entrada. Devuelve dependencias-primero."""
    base = repo / "static"
    orden, visto, pila = [], set(), []

    def visita(rel):
        if rel in visto:
            return
        visto.add(rel)
        f = base / rel
        if not f.is_file():
            raise SystemExit2(f"el panel declara {rel} y no existe en {base}")
        texto = f.read_text(encoding="utf-8", errors="replace")
        for esp in RE_IMPORT.findall(texto):
            hijo = (f.parent / esp).resolve()
            try:
                hijo_rel = hijo.relative_to(base.resolve()).as_posix()
            except ValueError:
                raise SystemExit2(f"{rel} importa {esp}, que cae FUERA de static/")
            visita(hijo_rel)
        orden.append(rel)

    visita(entrada)
    return orden


def fuentes(repo: pathlib.Path):
    ent = entradas_del_html(repo)
    if not ent:
        raise SystemExit2("static/index.html no declara ningun <script src=/static/...> "
                          "que no sea vendor: no hay panel que medir")
    salida = []
    for rel, tipo in ent:
        if tipo == "module":
            for x in grafo(repo, rel):
                if x not in salida:
                    salida.append(x)
        else:
            # script clasico: es un fichero suelto, sin grafo. Es la forma de HOY.
            f = repo / "static" / rel
            if not f.is_file():
                raise SystemExit2(f"el HTML declara {rel} y no existe")
            if rel not in salida:
                salida.append(rel)
    return salida


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--repo", default="/srv/coinanalyze/repo")
    ap.add_argument("--cat", action="store_true", help="concatena las fuentes, en orden")
    ap.add_argument("--n", action="store_true", help="solo el numero de ficheros")
    a = ap.parse_args()
    repo = pathlib.Path(a.repo)
    try:
        lista = fuentes(repo)
    except SystemExit2 as e:
        print(f"NO MEDIDO: {e.motivo}", file=sys.stderr)
        return 2
    if a.n:
        print(len(lista))
    elif a.cat:
        piezas = []
        for rel in lista:
            texto = (repo / "static" / rel).read_text(encoding="utf-8", errors="replace")
            # EL LIMITE DE `--cat`, Y SE DECLARA EN VEZ DE DISIMULARSE. Concatenar N modulos
            # en un solo ambito SOLO es fiel mientras los imports sean DE EFECTO
            # (`import './x.js';`): esos no atan nombres, solo ordenan la evaluacion, y el
            # orden ya lo da esta lista. Un import CON NOMBRES (`import {a} from './x.js'`)
            # si ata: concatenar lo convertiria en otra cosa, y quien lo midiera estaria
            # midiendo un panel que no existe. Ahi esto NO adivina: se niega.
            for m in RE_IMPORT_CON_NOMBRES.finditer(texto):
                print(f"NO MEDIDO: {rel} usa un import CON NOMBRES ({m.group(0).strip()[:60]}). "
                      "La concatenacion no puede representarlo: hace falta un cargador de "
                      "modulos de verdad. Vease la cabecera de panel-fuentes.", file=sys.stderr)
                return 2
            piezas.append(RE_IMPORT_DE_EFECTO.sub("", texto))
        for texto in piezas:
            sys.stdout.write(texto)
            # separador SOLO si hace falta: asi, con UN fichero que ya acaba en salto, la
            # concatenacion es BYTE A BYTE el fichero de hoy y la regresion se puede exigir
            # exacta en vez de «parecida».
            if not texto.endswith("\n"):
                sys.stdout.write("\n")
    else:
        for rel in lista:
            print(f"static/{rel}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
