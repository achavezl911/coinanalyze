#!/bin/bash
# respalda-libretas  ->  empuja las cuatro libretas fuera del nodo Proxmox.
#
# El criterio del arnes vive en cuatro ficheros que NO estan en el repo: hechos.tsv,
# COLA.md, CAMBIOS.md y ESTADO.md. harness/bin y harness/checks sobreviven porque son
# enlaces al repo, asi que sin esto se recuperarian los INSTRUMENTOS y no el CRITERIO.
#
# El destino es un repo APARTE y no el de la aplicacion: meterlas ahi anadiria churn a
# cada PR, que es un coste real. Y no es el respaldo de 140, que escribe en su propio
# rootfs /var/backups/coinalyze, o sea el MISMO nodo Proxmox: no cubre el fallo que
# importa.
#
# harness/secretos/ NO se copia a proposito. Son 1605 bytes regenerables -el nodo entra
# a 140 sin la clave- y lo irrecuperable es el criterio, no las llaves. harness/env si
# va: su primera linea dice que ahi no vive ningun secreto.
set -uo pipefail
DESTINO=${LIBRETAS_REMOTO:-https://github.com/achavezl911/coinanalyze-libretas.git}
COPIA=${LIBRETAS_COPIA:-/srv/coinanalyze/.libretas}

[ -d "$COPIA/.git" ] || git clone --quiet "$DESTINO" "$COPIA" || exit 1

install -m 644 /srv/coinanalyze/harness/hechos.tsv "$COPIA/hechos.tsv"
install -m 644 /srv/coinanalyze/harness/COLA.md    "$COPIA/COLA.md"
install -m 644 /srv/coinanalyze/harness/ESTADO.md  "$COPIA/ESTADO.md"
install -m 644 /srv/coinanalyze/CAMBIOS.md         "$COPIA/CAMBIOS.md"
install -m 644 /srv/coinanalyze/CLAUDE.md          "$COPIA/CLAUDE.md"
install -m 644 /srv/coinanalyze/harness/env        "$COPIA/env"

cd "$COPIA" || exit 1

# EL RESPALDO NO PISA LA PRUEBA. K49 caza que la copia dejo de ser prefijo del vivo, pero
# si el respaldo sigue corriendo empuja el hechos.tsv ya roto y la copia vuelve a cuadrar:
# la deteccion duraria lo que tarde el siguiente tick, o sea 5 minutos. Aqui se para en
# seco y se deja la ULTIMA COPIA BUENA en el remoto, asi que K49 se queda ROJO hasta que
# alguien mire. Un respaldo que sobrescribe la evidencia de su propio fallo no es un
# respaldo.
#
# LIBRETAS_FORZAR=1 lo salta, para el caso legitimo de corregir un hecho mal medido. Se
# pone a mano y se dice por que, como TODO=1 en el resto del arnes.
# La copia anterior se lee del propio commit -git show HEAD:hechos.tsv- y no de un
# fichero de al lado: asi no hay un duplicado de 185 KB viajando en cada push, y lo que
# se compara es EXACTAMENTE lo que hay en el remoto.
if [ "${LIBRETAS_FORZAR:-}" != "1" ] && git rev-parse --verify -q HEAD >/dev/null; then
  anterior=$(mktemp) || exit 1
  if git show HEAD:hechos.tsv > "$anterior" 2>/dev/null && [ -s "$anterior" ]; then
    n=$(wc -c < "$anterior")
    if [ "$(wc -c < /srv/coinanalyze/harness/hechos.tsv)" -lt "$n" ] ||
       [ "$(head -c "$n" /srv/coinanalyze/harness/hechos.tsv | sha256sum | cut -d' ' -f1)" \
         != "$(sha256sum "$anterior" | cut -d' ' -f1)" ]; then
      rm -f "$anterior"
      echo "respalda-libretas: hechos.tsv dejo de ser append-only respecto de la ultima copia." >&2
      echo "  NO se empuja, para no pisar la evidencia. LIBRETAS_FORZAR=1 si el cambio es a proposito." >&2
      exit 1
    fi
  fi
  rm -f "$anterior"
fi

# EL MANIFIESTO ES LA PRUEBA. Sin el, la unica forma de verificar la restauracion es
# comparar contra el fichero VIVO, y el vivo cambia entre un tick y el siguiente: el
# check saldria ROJO cada vez que alguien anade un hecho, diciendo "no cuadra" cuando lo
# unico que pasa es que la copia va tres minutos por detras. Un check que enrojece segun
# el momento acaba tratandose como ruido. Con el manifiesto se verifica lo que de verdad
# se promete: que lo que vuelve del remoto es byte a byte lo que se mando.
sha256sum hechos.tsv COLA.md ESTADO.md CAMBIOS.md CLAUDE.md env > SHA256SUMS

# EL CORTE VA DESPUES DEL PUSH, NO ANTES, Y ESA ERA LA AVERIA. Lo de antes era:
#     git add -A
#     git diff --cached --quiet && exit 0   <- aqui
#     git push --quiet origin HEAD 2>/dev/null || exit 1
# Un push que falla UNA vez deja el commit hecho EN LOCAL. En la corrida siguiente los
# ficheros ya no han cambiado, el indice sale limpio, y ese `exit 0` se lleva la corrida
# sin llegar nunca al push: no reintenta JAMAS. Medido el 2026-08-27: el remoto llevaba
# 25 h congelado -80 commits sin empujar, o sea la auditoria entera de un dia en un solo
# LXC- mientras el timer corria cada 5 min y la unit salia 0/SUCCESS.
# CONFUNDIA "no hay nada nuevo que preparar" con "ya esta todo empujado". Son la misma
# familia que K60 y K63: un instrumento que no distingue "no habia nada que hacer" de
# "falle y me rendi", y de las dos sale por la puerta buena.
#
# LA CONDICION AHORA ES LOCAL == REMOTO, y se le pregunta AL REMOTO. El indice solo
# decide si hay que hacer un commit nuevo; quien decide si hay que empujar es la
# comparacion con lo que el remoto tiene de verdad.
rama=$(git symbolic-ref --quiet --short HEAD) || {
  echo "respalda-libretas: la copia no esta en una rama; no se puede comparar con el remoto" >&2
  exit 1
}

git add -A
if ! git diff --cached --quiet; then
  git -c user.name=arnes -c user.email=arnes@coinalyze \
      commit -q -m "libretas $(date -u +%Y-%m-%dT%H:%M:%SZ)" || exit 1
fi

# NO SABER NO ES ESTAR BIEN, pero "la rama todavia no existe alli" SI es un estado
# legitimo: es la primera subida. Son dos cosas distintas y confundirlas es la misma
# averia que este arreglo persigue, un piso mas abajo. ls-remote las separa: rama
# ausente da rc=0 con salida vacia, y un remoto inalcanzable da rc!=0.
sha_remoto() {
  local salida rc
  salida=$(git ls-remote --heads origin "$rama" 2>&1); rc=$?
  if [ "$rc" -ne 0 ]; then printf '%s\n' "$salida" >&2; return 1; fi
  printf '%s' "$salida" | awk '{print $1; exit}'
}

remoto=$(sha_remoto) || {
  echo "respalda-libretas: no se pudo consultar el remoto ($DESTINO)" >&2
  exit 1
}

# EL CONTROL POSITIVO QUE HAY QUE CONSERVAR: si el remoto ya tiene exactamente esto, se
# sale 0 y en silencio. Es lo que buscaba el atajo viejo -que un timer de 5 minutos no
# ensucie el log- y sigue cumpliendose, solo que ahora la pregunta es la correcta.
[ -n "$remoto" ] && [ "$(git rev-parse HEAD)" = "$remoto" ] && exit 0

# EL PUSH CONSERVA SU stderr. Antes iba a /dev/null, asi que la unit moria sin decir por
# que y el operador se quedaba con un rc pelado.
git push origin HEAD || exit 1

# Y SE VERIFICA DESPUES: que el push devuelva 0 no prueba que el remoto quedara al dia.
# Si sigue por detras, la unit FALLA en vez de salir 0, que es justo lo que no hacia.
remoto=$(sha_remoto) || {
  echo "respalda-libretas: se empujo pero no se pudo confirmar el remoto" >&2
  exit 1
}
[ "$(git rev-parse HEAD)" = "$remoto" ] || {
  echo "respalda-libretas: el remoto sigue por detras del local despues del push" >&2
  echo "  local=$(git rev-parse HEAD) remoto=${remoto:-<la rama no existe en el remoto>}" >&2
  exit 1
}
