# Coinalyze
API_KEY=replace_with_coinalyze_api_key
COINALYZE_BASE_URL=https://api.coinalyze.net/v1
INGEST_INTERVAL_SECONDS=60
COINALYZE_RATE_LIMIT_UNITS=35
MARKET_SYMBOL_CATALOG_FILE=

# Macro externo. FRED/BLS/Fed/DefiLlama no requieren clave; CoinGlass ETF es opcional.
EXTERNAL_MACRO_ENABLED=true
EXTERNAL_MACRO_REFRESH_SECONDS=3600
COINGLASS_API_KEY=

# PostgreSQL local
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=coinalyze
PG_USER=coinalyze
PG_PASSWORD=replace_with_long_random_password
PG_POOL_MIN=1
PG_POOL_MAX=4
PG_SSLMODE=disable

# API
API_HOST=127.0.0.1
API_PORT=8000
API_INTERNAL_TOKEN=replace_with_hex_secret_required
API_INTERNAL_ALLOWED_CIDRS='["127.0.0.1/32","::1/128","10.10.100.0/28"]'
# CIDR reales que nginx permite para acceder al dashboard por 8090/8443.
NGINX_ALLOWED_CIDRS='["127.0.0.1/32","::1/128","10.10.100.0/28"]'
METRICS_ENABLED=true
LOG_LEVEL=INFO
TRUSTED_HOSTS='["127.0.0.1","localhost"]'

# Data lifecycle
HARD_DATA_RETENTION_DAYS=14
HTF_DATA_RETENTION_DAYS=400
SNAPSHOT_RETENTION_DAYS=30
REALTIME_RETENTION_HOURS=2
DAILY_LOOKBACK_DAYS=13
DAILY_SESSION_RETENTION_DAYS=0

# Optional subset. Empty/omitted means every entry in the versioned market catalog.
# SYMBOLS='["BTCUSDT_PERP.A","ETHUSDT_PERP.A","SOLUSDT_PERP.A"]'

# Collector ownership. Template units override INDEX with their %i instance.
COLLECTOR_SHARD_INDEX=0
COLLECTOR_SHARD_COUNT=1

# Scalp mode
SCALP_ENABLED=true
SCALP_FLUSH_SECONDS=2
SCALP_ORDERBOOK_FLUSH_SECONDS=2
SCALP_TRADE_RETENTION_HOURS=6
SCALP_ORDERBOOK_RETENTION_HOURS=6
SCALP_SIGNAL_INTERVAL_SECONDS=10
SCALP_SIGNAL_RETENTION_HOURS=72
TRADESTORE_MAX_BUCKET_MINUTES=20
TRADESTORE_MAX_BUCKETS_PER_KEY=30
BINANCE_BOOK_MAX_EVENT_LAG_SECONDS=10
BINANCE_BOOK_STALE_SECONDS=15
BINANCE_BOOK_FORCE_RECONNECT_SECONDS=3600
