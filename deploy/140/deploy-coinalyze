#!/usr/bin/env bash
# =============================================================================
# deploy-coinalyze v2 — TRUST BOUNDARY for Coinalyze production deployments
#
# Key invariants:
#   * Never switch /opt/coinalyze/current before schema succeeds.
#   * Quiesce the application DB clients before DDL.
#   * Never terminate PostgreSQL sessions automatically: fail closed instead.
#   * Any failure after quiescing restores the prior release and services.
#   * A rollback is successful only when its smoke test succeeds.
# =============================================================================
set -Eeuo pipefail
export LANG=C.UTF-8 LC_ALL=C.UTF-8
umask 022

APP_ROOT=/opt/coinalyze
RELEASES="$APP_ROOT/releases"
CURRENT="$APP_ROOT/current"
STATE=/var/lib/coinalyze/deployment.json
LOGDIR=/var/log/coinalyze
LOG="$LOGDIR/deploy.log"
ENV_FILE=/etc/coinalyze/coinalyze.env
BACKUPDIR=/var/backups/coinalyze
LOCKFILE=/run/lock/deploy-coinalyze.lock
# Solo se despliega lo que es origin/main en GitHub en ese momento (API publica, solo lectura, sin credenciales).
GITHUB_API=https://api.github.com
GITHUB_REPO=achavezl911/coinanalyze
# El venv del release lo construye el usuario del servicio, no root: pip ejecuta codigo de los paquetes al instalar.
SERVICE_USER=coinalyze

SERVICES=(coinalyze-api coinalyze-ingest coinalyze-ws coinalyze-scalp coinalyze-daily)
UNIT_DIR=/etc/systemd/system
# Unidades que se instalan aparte (el OPERADOR, una vez): se paran y se vuelven a arrancar con el despliegue SOLO si
# estan instaladas. El recuperador (deploy/140/coinalyze-recupera.*) abre sesion en la base: corriendo durante el
# despliegue, wait_db_quiet negaria el esquema.
OPTIONAL_STOP=(coinalyze-recupera.timer coinalyze-recupera.service)
OPTIONAL_START=(coinalyze-recupera.timer)
# Las que la API arrastra (deploy/140/coinalyze-{orderflow,libro,bot}.service: PartOf= y WantedBy= coinalyze-api). Un
# `systemctl restart coinalyze-api` normal las reinicia; el camino parcial (R1) reinicia la API con
# --job-mode=ignore-requirements y a cada una solo si le toca.
PARTOF_API=(coinalyze-orderflow coinalyze-libro coinalyze-bot)
# REINICIO R1. El punto de entrada de cada unidad, el de su ExecStart (tests/test_deploy_reinicio.py lo comprueba).
# Si sql/schema.sql no cambia, solo se reinicia la API y la unidad cuyo cierre de imports (scripts/cierre_imports.py)
# cambia respecto del release del que corre; las demas siguen con su codigo en memoria y la poda no les borra el release.
declare -A ENTRY=(
  [coinalyze-api]=app.api [coinalyze-ingest]=app.ingest [coinalyze-ws]=app.ws_collector
  [coinalyze-scalp]=app.scalp_collector [coinalyze-daily]=app.daily_agg
  [coinalyze-orderflow]=app.orderflow [coinalyze-libro]=app.libro [coinalyze-bot]=app.bot
)
CIERRE=scripts/cierre_imports.py
PROC=/proc

KEEP_RELEASES=5
SMOKE_URL=http://127.0.0.1:8000
# Espera maxima DECLARADA para un «degraded» de arranque. Lo mas lento que se espera: ingest, que late con su
# primer ciclo (~60 s) y la cola de simbolos (lag de metrics_snapshot <= 180 s). 450 s cubre los dos con margen.
SMOKE_MAX_WAIT=450
SMOKE_SLEEP=5
# Latidos que tienen que haber llegado DESPUES del reinicio. daily no: late al acabar su ciclo (horario).
SMOKE_REQUIRED_HEARTBEATS="api ingest ws scalp"
SMOKE_SINCE=""
SMOKE_PREFER=""
DB_QUIET_TRIES=20
DB_QUIET_SLEEP=1
PG_LOCK_TIMEOUT=15s
PG_STATEMENT_TIMEOUT=300s

mkdir -p "$LOGDIR"
touch "$LOG"
chmod 640 "$LOG"

log(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG" >&2; }
die(){ log "ERROR: $*"; exit "${2:-1}"; }

[ "$(id -u)" -eq 0 ] || die "must run as root (via sudo)"

# Serialize wrapper invocations even if somebody bypasses GitHub Actions concurrency.
exec 9>"$LOCKFILE"
flock -n 9 || die "another deploy-coinalyze operation is already running" 14

active_sha(){
  [ -L "$CURRENT" ] && basename "$(readlink -f "$CURRENT")" || true
}

load_env(){
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
}

write_state(){
  cat > "$STATE" <<JSON
{
  "commit": "$1",
  "branch": "main",
  "deployed_at": "$(date -u +%FT%TZ)",
  "previous_commit": "$2",
  "deployment_source": "$3"
}
JSON
  chmod 644 "$STATE"
}

# Smoke = scripts/smoke_test.sh de un release (healthz «ok», latidos posteriores al reinicio, unidades
# activas, simbolos, perfiles, /metrics y las rutas por simbolo). «degraded» solo se espera mientras sea por
# un motivo de ARRANQUE conocido (smoke_test.sh sale con 75), como mucho SMOKE_MAX_WAIT segundos; un fallo
# definitivo (86: unidad failed, latido en error despues del reinicio, degraded sin motivo de arranque) no
# se espera. Si no pasa, quien llama revierte como siempre. El token no lo toca este fichero: smoke_test.sh
# lo lee de ENV_FILE y se lo da a curl en un fichero de cabeceras 0600, nunca en el argv.
smoke_script(){
  local c
  for c in "$SMOKE_PREFER" "$(readlink -f "$CURRENT" 2>/dev/null || true)/scripts/smoke_test.sh"; do
    if [ -n "$c" ] && [ -f "$c" ] && grep -q '^# smoke-contract: 2 ' "$c"; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  return 1
}

smoke(){
  local script rc out deadline
  script="$(smoke_script)" || {
    log "smoke FAILED: no smoke_test.sh with smoke-contract 2 in the candidate or current release"
    return 1
  }
  deadline=$(( $(date +%s) + SMOKE_MAX_WAIT ))
  while :; do
    rc=0
    out="$(COINALYZE_ENV_FILE="$ENV_FILE" DEPLOY_RESTART_EPOCH="$SMOKE_SINCE" \
      REQUIRED_HEARTBEATS="$SMOKE_REQUIRED_HEARTBEATS" REQUIRED_SYSTEMD_SERVICES="${SERVICES[*]}" \
      bash "$script" "$SMOKE_URL" 2>&1)" || rc=$?
    if [ "$rc" -eq 0 ]; then
      log "smoke OK ($script)"
      return 0
    fi
    if [ "$rc" -eq 86 ]; then
      log "smoke FAILED (definitive, rc=86): $(printf '%s' "$out" | tail -n 1)"
      return 1
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      log "smoke FAILED after ${SMOKE_MAX_WAIT}s (rc=$rc): $(printf '%s' "$out" | tail -n 1)"
      return 1
    fi
    sleep "$SMOKE_SLEEP"
  done
}

github_main_sha(){
  local sha
  sha="$(curl -fsS --proto '=https' -m 20 -H 'Accept: application/vnd.github.sha' \
    "$GITHUB_API/repos/$GITHUB_REPO/commits/main" | tr -d '[:space:]')" || return 1
  printf '%s' "$sha" | grep -Eq '^[0-9a-f]{40}$' || return 1
  printf '%s\n' "$sha"
}

# El arbol de ese commit tal como lo sirve GitHub (una carpeta de cabeza <dueno>-<repo>-<sha7>/; la acepta cmd_deploy).
github_tarball(){
  curl -fsSL --proto '=https' --proto-redir '=https' -m 300 -o "$2" "$GITHUB_API/repos/$GITHUB_REPO/tarball/$1"
}

as_service(){
  runuser -u "$SERVICE_USER" -- env HOME=/nonexistent PIP_NO_CACHE_DIR=1 "$@"
}

installed_units(){
  local u
  for u in "$@"; do [ -f "$UNIT_DIR/$u" ] && printf '%s\n' "$u"; done
  return 0
}

stop_services(){
  log "stopping application services before schema"
  local opt=()
  mapfile -t opt < <(installed_units "${OPTIONAL_STOP[@]}")
  [ "${#opt[@]}" -eq 0 ] || systemctl stop "${opt[@]}" || log "optional units did not stop: ${opt[*]}"
  systemctl stop "${SERVICES[@]}"
  local s
  for s in "${SERVICES[@]}"; do
    if systemctl is-active --quiet "$s"; then
      log "service failed to stop: $s"
      return 1
    fi
  done
  log "application services stopped"
}

start_optional(){
  local opt=()
  mapfile -t opt < <(installed_units "${OPTIONAL_START[@]}")
  [ "${#opt[@]}" -eq 0 ] || systemctl start "${opt[@]}" || log "optional units did not start: ${opt[*]}"
  return 0
}

start_services(){
  SMOKE_SINCE="$(date +%s)"
  systemctl start "${SERVICES[@]}" || return 1
  start_optional
}

restart_services(){
  SMOKE_SINCE="$(date +%s)"
  systemctl restart "${SERVICES[@]}" || return 1
  start_optional
}

# Las unidades del despliegue: SERVICES y las arrastradas por la API que esten instaladas.
deploy_units(){
  printf '%s\n' "${SERVICES[@]}"
  local u
  for u in "${PARTOF_API[@]}"; do [ -f "$UNIT_DIR/$u.service" ] && printf '%s\n' "$u"; done
  return 0
}

# El release del que corre de verdad una unidad viva: el cwd de su MainPID (systemd entra en current y el kernel
# resuelve el enlace). Nada si no corre; «?» si corre y su cwd no se lee o no esta en un release.
running_release(){
  local pid cwd r
  pid="$(systemctl show -p MainPID --value "$1" 2>/dev/null || true)"
  case "$pid" in ''|0|*[!0-9]*) return 0 ;; esac
  cwd="$(readlink -f "$PROC/$pid/cwd" 2>/dev/null)" || cwd=""
  case "$cwd" in
    "$RELEASES"/?*) r="${cwd#"$RELEASES"/}"; printf '%s\n' "${r%%/*}" ;;
    *) echo '?' ;;
  esac
  return 0
}

# Ninguna release de la que corra una unidad viva se borra, este donde este en el orden; si de una unidad viva no se
# sabe de que release corre, no se poda nada (no se sabe cual protege).
prune_releases(){
  local d r u kept=0 all=() vivos=" "
  while IFS= read -r u; do
    r="$(running_release "$u")"
    [ "$r" != '?' ] || { log "prune skipped: cannot tell which release running $u executes"; return 0; }
    [ -z "$r" ] || vivos+="$r "
  done < <(deploy_units)
  while IFS= read -r d; do all+=("$d"); done < <(ls -1dt "$RELEASES"/*/ 2>/dev/null || true)
  for d in "${all[@]}"; do
    case "$d" in */legacy-*/) continue ;; esac
    kept=$((kept+1))
    [ "$kept" -gt "$KEEP_RELEASES" ] || continue
    r="$(basename "$d")"
    case "$vivos" in *" $r "*) log "prune: keeping $r (a running service executes it)"; continue ;; esac
    rm -rf "$d"
  done
  return 0
}

# Decide que unidades se reinician (R1). Deja la lista en PLAN y devuelve 0; devuelve 1 si toca el camino completo de
# siempre (parar todo, esquema, arrancar todo): esquema distinto byte a byte, o una decision que no se puede tomar.
# La API se reinicia siempre (sirve static/ de su release). Cada linea del plan va al log con su motivo.
PLAN=()
plan_restarts(){
  local cand="$1" cur="$2" u r out ver why specs=()
  PLAN=()
  if ! cmp -s "$cur/sql/schema.sql" "$cand/sql/schema.sql"; then
    log "restart plan: sql/schema.sql changed -> stop all, apply schema, restart all"
    return 1
  fi
  [ -f "$cand/$CIERRE" ] || { log "restart plan: candidate has no $CIERRE -> stop all, restart all"; return 1; }
  while IFS= read -r u; do
    r="$(running_release "$u")"
    if [ "$u" = coinalyze-api ]; then
      PLAN+=("$u"); log "restart plan: $u restart (always: the API serves static/ from its release)"
    elif [ "$r" = '?' ] || { [ -n "$r" ] && [ ! -d "$RELEASES/$r" ]; }; then
      PLAN+=("$u"); log "restart plan: $u restart (running release unknown: ${r})"
    elif [ -z "$r" ]; then
      # Parada: una de SERVICES se arranca, como hoy; una arrastrada por la API (el bot, p. ej.) se deja como esta.
      case " ${PARTOF_API[*]} " in
        *" $u "*) log "restart plan: $u keep (not running; left as is)" ;;
        *) PLAN+=("$u"); log "restart plan: $u restart (not running)" ;;
      esac
    else
      specs+=("$u=${ENTRY[$u]:?no ENTRY for $u}=$RELEASES/$r")
    fi
  done < <(deploy_units)
  [ "${#specs[@]}" -eq 0 ] && return 0
  out="$(python3 -I "$cand/$CIERRE" decide "$cand" "${specs[@]}")" \
    || { log "restart plan: $CIERRE failed -> stop all, apply schema, restart all"; return 1; }
  while read -r u ver why; do
    log "restart plan: $u $ver $why"
    [ "$ver" = keep ] || PLAN+=("$u")
  done <<< "$out"
  return 0
}

# Reinicia solo las unidades de la lista: la API sin arrastrar a sus PartOf, las demas una a una.
restart_units(){
  SMOKE_SINCE="$(date +%s)"
  local u rc=0
  for u in "$@"; do
    if [ "$u" = coinalyze-api ]; then
      systemctl restart --job-mode=ignore-requirements "$u" || rc=1
    else
      systemctl restart "$u" || rc=1
    fi
  done
  return "$rc"
}

ensure_units(){
  local u changed=0
  for u in "${SERVICES[@]}"; do
    local f="$UNIT_DIR/$u.service"
    [ -f "$f" ] || continue
    if ! grep -q "$CURRENT" "$f"; then
      cp -a "$f" "$f.pre-releases.bak" 2>/dev/null || true
      sed -i \
        -e "s#^WorkingDirectory=${APP_ROOT}\$#WorkingDirectory=${CURRENT}#" \
        -e "s#${APP_ROOT}/\.venv#${CURRENT}/.venv#g" \
        "$f"
      changed=1
    fi
  done
  if [ "$changed" = 1 ]; then
    systemctl daemon-reload
    log "systemd units repointed to $CURRENT"
  fi
}

do_backup(){
  load_env
  mkdir -p "$BACKUPDIR"
  chmod 700 "$BACKUPDIR"

  # Poda ANTES del volcado nuevo: se queda el predeploy mas reciente (el del release activo); tras este, quedan 2.
  local f n=0
  while IFS= read -r -d '' f; do
    n=$((n + 1)); [ "$n" -le 1 ] && continue
    f=${f#* }; rm -f -- "$f" "$f.sha256"; log "pruned pre-deploy backup: $f"
  done < <(find "$BACKUPDIR" -maxdepth 1 -type f -name 'predeploy-*.sql.gz' -printf '%T@ %p\0' | LC_ALL=C sort -z -rn)

  local out="$BACKUPDIR/predeploy-$1-$(date -u +%Y%m%d%H%M%S).sql.gz"
  PGPASSWORD="${PG_PASSWORD:-}" pg_dump \
    -h "${PG_HOST:-127.0.0.1}" \
    -p "${PG_PORT:-5432}" \
    -U "${PG_USER:?}" \
    "${PG_DB:?}" | gzip > "$out" || die "DB backup failed" 5

  log "pre-deploy DB backup: $out"
  find "$BACKUPDIR" -name 'predeploy-*.sql.gz' -mtime +14 -delete 2>/dev/null || true
}

# After the core app services are stopped, require that no other client backend
# using the application DB role remains. Do not terminate sessions automatically.
wait_db_quiet(){
  load_env
  local i count

  for i in $(seq 1 "$DB_QUIET_TRIES"); do
    count="$(
      PGPASSWORD="${PG_PASSWORD:-}" psql \
        -h "${PG_HOST:-127.0.0.1}" \
        -p "${PG_PORT:-5432}" \
        -U "${PG_USER:?}" \
        -d "${PG_DB:?}" \
        -Atq \
        -c "SELECT count(*)
            FROM pg_stat_activity
            WHERE datname = current_database()
              AND usename = current_user
              AND backend_type = 'client backend'
              AND pid <> pg_backend_pid();" \
        | tr -d '[:space:]'
    )"

    if [ "${count:-}" = "0" ]; then
      log "application DB role is quiescent"
      return 0
    fi
    sleep "$DB_QUIET_SLEEP"
  done

  log "remaining application-role DB sessions:"
  PGPASSWORD="${PG_PASSWORD:-}" psql \
    -h "${PG_HOST:-127.0.0.1}" \
    -p "${PG_PORT:-5432}" \
    -U "${PG_USER:?}" \
    -d "${PG_DB:?}" \
    -P pager=off \
    -c "SELECT pid, application_name, client_addr, state,
               wait_event_type, wait_event,
               left(query, 120) AS query
        FROM pg_stat_activity
        WHERE datname = current_database()
          AND usename = current_user
          AND backend_type = 'client backend'
          AND pid <> pg_backend_pid()
        ORDER BY pid;" >&2 || true

  return 1
}

# Apply the candidate release's schema WITHOUT changing current first.
apply_schema(){
  local schema_path="$1"
  [ -f "$schema_path" ] || die "schema file not found: $schema_path" 6

  load_env
  local tmp="/tmp/coinalyze-schema.$$.sql"
  install -m 0644 "$schema_path" "$tmp"

  local rc=0
  PGOPTIONS="-c lock_timeout=${PG_LOCK_TIMEOUT} -c statement_timeout=${PG_STATEMENT_TIMEOUT}" \
  PGPASSWORD="${PG_PASSWORD:-}" psql \
    -h "${PG_HOST:-127.0.0.1}" \
    -p "${PG_PORT:-5432}" \
    -U "${PG_USER:?}" \
    -d "${PG_DB:?}" \
    -v ON_ERROR_STOP=1 \
    -f "$tmp" || rc=$?

  rm -f "$tmp"

  [ "$rc" -eq 0 ] || return "$rc"
  log "schema applied"
}

switch_to(){
  local target="$1"
  case "$(readlink -f "$target")" in
    "$RELEASES"/*) ;;
    *) die "refusing to switch current outside releases: $target" 11 ;;
  esac
  ln -sfn "$target" "$CURRENT.new"
  mv -Tf "$CURRENT.new" "$CURRENT"
}

# Roll back to a known release. Return non-zero when the rollback target does
# not pass smoke; callers MUST NOT claim success in that case.
do_rollback_to(){
  local target="$1"
  [ -n "$target" ] && [ -d "$RELEASES/$target" ] || {
    log "no valid rollback target ($target)"
    return 1
  }

  log "rolling back to $target"
  switch_to "$RELEASES/$target"
  ensure_units

  # Services may currently be stopped or running; restart gives a known state.
  restart_services || return 1

  if smoke; then
    log "rollback to $target OK"
    return 0
  fi

  log "ERROR: rollback smoke failed for $target"
  return 1
}

# Deployment failure guard.
# It is armed only after backup, just before services are quiesced.
DEPLOY_GUARD_ARMED=0
DEPLOY_PREV=""
DEPLOY_SERVICES_QUIESCED=0
DEPLOY_SWITCHED=0
DEPLOY_SUCCESS=0
DEPLOY_PARTIAL=0
DEPLOY_RESTARTED=()

deploy_exit_guard(){
  local rc=$?

  if [ "$DEPLOY_GUARD_ARMED" = 1 ] && [ "$DEPLOY_SUCCESS" != 1 ]; then
    trap - EXIT
    set +e

    log "deployment aborted (rc=$rc); restoring previous release ${DEPLOY_PREV:-none}"

    if [ "$DEPLOY_SWITCHED" = 1 ] && [ -n "$DEPLOY_PREV" ] && [ -d "$RELEASES/$DEPLOY_PREV" ]; then
      switch_to "$RELEASES/$DEPLOY_PREV"
    fi

    # If services were stopped, start them. If the candidate had already been
    # switched in and started, restart after restoring the old symlink so the
    # processes actually execute the previous release.
    # Camino parcial (R1): se vuelven a reiniciar las mismas, ya sobre el release anterior; las demas no se tocaron.
    if [ "$DEPLOY_SWITCHED" = 1 ] && [ "$DEPLOY_PARTIAL" = 1 ]; then
      restart_units "${DEPLOY_RESTARTED[@]}"
    elif [ "$DEPLOY_SWITCHED" = 1 ]; then
      restart_services
    elif [ "$DEPLOY_SERVICES_QUIESCED" = 1 ]; then
      start_services
    fi

    if [ -n "$DEPLOY_PREV" ] && [ -d "$RELEASES/$DEPLOY_PREV" ]; then
      if smoke; then
        log "automatic recovery to $DEPLOY_PREV OK"
      else
        log "CRITICAL: automatic recovery smoke FAILED for $DEPLOY_PREV"
      fi
    fi

    # deployment.json intentionally remains unchanged on failed deploy.
    exit "$rc"
  fi

  trap - EXIT
  exit "$rc"
}

trap deploy_exit_guard EXIT

cmd_deploy(){
  local commit="$1"

  echo "$commit" | grep -Eq '^[0-9a-f]{40}$' || die "bad commit sha (want the full 40-hex sha): $commit" 2
  # D-02: el release que corre no se reconstruye encima (se borraria antes de armar la guarda).
  [ "$commit" != "$(active_sha)" ] || die "commit $commit is already the active release" 17

  # Falla cerrado: GitHub que no contesta o un main que ya se movio niegan el despliegue (se relanza).
  local main_sha=""
  main_sha="$(github_main_sha)" || main_sha=""
  [ "$main_sha" = "$commit" ] \
    || die "commit $commit is not origin/main on GitHub (main=${main_sha:-unreachable})" 16
  log "commit is origin/main on GitHub"

  # D-01: el CONTENIDO lo baja root de GitHub para ese sha; quien llama dice una cadena y no entrega nada.
  local stage
  stage="$(mktemp -d "$RELEASES/.stage.XXXXXX")"
  if ! github_tarball "$commit" "$stage.tgz" \
     || ! tar --no-same-owner --no-same-permissions -xzf "$stage.tgz" -C "$stage"; then
    rm -rf "$stage" "$stage.tgz"
    die "could not fetch $commit from GitHub" 3
  fi
  rm -f "$stage.tgz"
  log "source fetched from GitHub ($commit)"

  local src="$stage"
  if [ ! -f "$stage/pyproject.toml" ]; then
    local only
    only="$(find "$stage" -maxdepth 1 -mindepth 1 | head -1)"
    [ -f "$only/pyproject.toml" ] && src="$only"
  fi

  local p
  for p in pyproject.toml requirements.lock sql/schema.sql app static scripts/smoke_test.sh; do
    [ -e "$src/$p" ] || {
      rm -rf "$stage"
      die "incomplete source tree, missing $p" 4
    }
  done

  local rel="$RELEASES/$commit"
  SMOKE_PREFER="$rel/scripts/smoke_test.sh"
  rm -rf "$rel"
  mkdir -p "$rel"
  cp -a "$src/." "$rel/"
  rm -rf "$stage"

  # Construido por SERVICE_USER, sin cache ni HOME de root; despues, el release pasa a root:coinalyze de solo lectura.
  chown -R "$SERVICE_USER:$SERVICE_USER" "$rel"
  as_service python3 -m venv "$rel/.venv" || die "venv creation failed" 7
  as_service "$rel/.venv/bin/pip" install --disable-pip-version-check --no-cache-dir -q \
    -r "$rel/requirements.lock" || die "pip requirements failed" 7
  as_service "$rel/.venv/bin/pip" install --disable-pip-version-check --no-cache-dir -q --no-deps \
    "$rel" || die "pip package install failed" 7

  chown -R root:coinalyze "$rel"
  find "$rel" -path "$rel/.venv" -prune -o -type d -exec chmod 0750 {} + 2>/dev/null || true
  find "$rel" -path "$rel/.venv" -prune -o -type f -exec chmod 0640 {} + 2>/dev/null || true
  find "$rel/.venv/bin" -type f -exec chmod 0750 {} + 2>/dev/null || true

  log "release built: $rel"

  local prev
  prev="$(active_sha)"
  do_backup "$commit"

  # FIRST-RUN migration: no current symlink yet -> snapshot the live tree.
  if [ ! -L "$CURRENT" ]; then
    log "first run: migrating legacy layout into the releases model"
    if [ -d "$APP_ROOT/app" ]; then
      local legacy="legacy-$(date -u +%Y%m%d%H%M%S)"
      mkdir -p "$RELEASES/$legacy"
      rsync -a --exclude releases --exclude current "$APP_ROOT"/ "$RELEASES/$legacy"/
      [ -d "$RELEASES/$legacy/.venv" ] \
        || python3 -m venv "$RELEASES/$legacy/.venv" >/dev/null 2>&1 || true
      prev="$legacy"
      log "legacy snapshot: $RELEASES/$legacy"
    fi
  fi

  [ -n "$prev" ] && [ -d "$RELEASES/$prev" ] \
    || die "no valid previous release available before production mutation" 11

  DEPLOY_PREV="$prev"
  DEPLOY_GUARD_ARMED=1

  local kept=()
  if plan_restarts "$rel" "$RELEASES/$prev"; then
    # R1: el esquema no cambia -> nada se para ni se aplica; se cambia current y se reinicia solo el PLAN.
    DEPLOY_PARTIAL=1
    DEPLOY_RESTARTED=("${PLAN[@]}")
    mapfile -t kept < <(deploy_units | grep -vxF -f <(printf '%s\n' "${PLAN[@]}"))
    switch_to "$rel"
    DEPLOY_SWITCHED=1
    log "current -> $rel"
    ensure_units
    restart_units "${PLAN[@]}"
    log "restarted: ${PLAN[*]}; kept running: ${kept[*]:-none} (no schema change; reasons above)"
  else
    # Quiesce application DB clients BEFORE DDL. Arm the service-recovery
    # flag BEFORE the stop call so even a partial stop is recovered by the EXIT guard.
    DEPLOY_SERVICES_QUIESCED=1
    stop_services

    wait_db_quiet || die "application DB sessions remain after service stop; refusing schema apply" 15

    # Candidate schema is applied while current still points to the old release.
    # This requires migrations to remain rollback-compatible with the previous code.
    apply_schema "$rel/sql/schema.sql" || die "schema apply failed" 6

    # Only after schema succeeds may the candidate become current.
    switch_to "$rel"
    DEPLOY_SWITCHED=1
    log "current -> $rel"

    ensure_units
    start_services
    DEPLOY_SERVICES_QUIESCED=0
    log "restarted: $(deploy_units | tr '\n' ' ')(full path: stop all, schema, start all)"
  fi

  if ! smoke; then
    die "smoke test failed for $commit" 10
  fi

  write_state "$commit" "$prev" "github-actions"
  prune_releases

  DEPLOY_SUCCESS=1
  DEPLOY_GUARD_ARMED=0

  log "DEPLOY OK $commit (previous $prev)"
  echo "DEPLOY_OK $commit"
}

cmd_rollback(){
  [ -f "$STATE" ] || die "no deployment state to roll back from" 12

  local target
  target="$(sed -n 's/.*"previous_commit": *"\([^"]*\)".*/\1/p' "$STATE" | head -1)"
  [ -n "$target" ] && [ "$target" != "none" ] || die "no previous_commit recorded" 12

  local cur
  cur="$(active_sha)"
  [ -n "$cur" ] && [ -d "$RELEASES/$cur" ] || die "current release is invalid ($cur)" 12
  # El smoke del release del que se sale (el mas nuevo): el del destino puede ser de antes del contrato 2.
  SMOKE_PREFER="$RELEASES/$cur/scripts/smoke_test.sh"

  if do_rollback_to "$target"; then
    write_state "$target" "$cur" "manual-rollback"
    echo "ROLLBACK_OK to $target"
    return 0
  fi

  log "rollback target $target failed smoke; restoring original release $cur"
  if do_rollback_to "$cur"; then
    log "original release $cur restored after failed rollback"
  else
    die "CRITICAL: rollback failed and original release could not be restored" 13
  fi

  die "rollback target $target failed smoke; original release restored" 13
}

cmd_status(){
  echo "active_release: $(active_sha || echo none)"
  echo "services:"
  local s
  while IFS= read -r s; do
    printf '  %s %s release=%s\n' "$s" "$(systemctl is-active "$s" 2>/dev/null || true)" "$(running_release "$s")"
  done < <(deploy_units)

  echo "releases:"
  local d
  for d in "$RELEASES"/*/; do
    [ -d "$d" ] || continue
    printf '  %s\n' "$(basename "$d")"
  done

  echo "state:"
  if [ -f "$STATE" ]; then
    cat "$STATE"
  else
    echo "  (none)"
  fi

  SMOKE_MAX_WAIT=0  # una foto, sin esperar arranques
  if smoke; then
    echo "smoke: OK"
  else
    echo "smoke: FAILED"
    return 1
  fi
}

case "${1:-}" in
  deploy)
    shift
    # Dos firmas: `deploy <commit>` y la del workflow de hoy, `deploy <artifact> <sha256> <commit>`, de la que solo
    # cuenta el commit: el tar y su suma los trae quien llama, y de eso no se fia (D-01). El codigo, de GitHub.
    case $# in
      1) cmd_deploy "$1" ;;
      3) log "caller artifact ignored; the source comes from GitHub"; cmd_deploy "$3" ;;
      *) die "usage: deploy <commit> | deploy <artifact> <sha256> <commit>" 2 ;;
    esac
    ;;
  rollback)
    cmd_rollback
    ;;
  status)
    cmd_status
    ;;
  *)
    echo "usage: deploy-coinalyze {deploy <commit>|deploy <artifact> <sha256> <commit>|rollback|status}" >&2
    exit 64
    ;;
esac
