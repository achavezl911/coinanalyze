# DIARIO DE ENTRADAS (fase 2) · cada 15 min (python -m app.diario cuarto): velas de 140 por harness/bin/api (solo
# lectura) a /srv/coinanalyze/diario/velas; resuelve lo sellado; evalua D:imp1:v0:A y H:imp6:v1:D en la barra recien
# cerrada; sella o rechaza el buzon de Fable (/srv/coinanalyze/diario/buzon). Escribe SOLO en /srv/coinanalyze/diario.
# Como root: harness/bin/api usa su netrc. Corre la COPIA CONGELADA de main (/opt/coinalyze-143/current) con el
# python del sistema, sin el venv del arbol (E-01). La instala el OPERADOR con deploy/143/instala.sh.
[Unit]
Description=Coinalyze diario de entradas: resolver, reglas y buzon (cada 15 min)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/coinalyze-143/current
Environment=HOME=/root
Environment=DIARIO_DIR=/srv/coinanalyze/diario
ExecStart=/usr/bin/python3 -E -s -m app.diario cuarto
TimeoutStartSec=10min
