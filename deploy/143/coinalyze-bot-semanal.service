# BOT-2 remate 1 · el INFORME SEMANAL del bot por Claude Max, en 143 (tools/bot/semanal.py). Como root: es quien tiene la
# sesion de Max de Claude Code (/root/.claude) y la llave de harness/bin/prod y prodsql. Lee las tablas del bot por el
# canal de solo lectura y deja el texto (o la causa de que no salga) en 140, en /var/lib/coinalyze-bot/informes/.
# DATOS B (fable-f8 F3): corre la COPIA CONGELADA de main que deja deploy/143/instala.sh en /opt/coinalyze-143, de root y
# solo lectura, nunca el arbol de trabajo /srv/coinanalyze/repo (alli se sacan ramas). Solo stdlib: python3 -I, sin venv.
# La instala el OPERADOR con deploy/143/instala.sh.
[Unit]
Description=Coinalyze bot (BOT-2): informe semanal por Claude Max (claude -p, opus, xhigh)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/coinanalyze
Environment=HOME=/root
ExecStart=/usr/bin/python3 -I /opt/coinalyze-143/current/tools/bot/semanal.py
TimeoutStartSec=45min
